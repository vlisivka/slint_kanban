import { TextEdit, LineEdit, Button, Palette } from "std-widgets.slint";

export struct RefStr {
    id: string,
    title: string,
}

export struct TicketStr {
    id: string,
    title: string,
    description: string,
    snippet: string,
    created_at: string,
    updated_at: string,
    assigned_to: string,
    author: string,
    references: [RefStr],
}

export struct QueueStr {
    id: string,
    name: string,
    tickets: [TicketStr],
    limit: int,           // -1 means no limit
    ticket_count: int,
    visible: bool,
}

export component AppConfig {
    out property <length> column-width: 280px;
    out property <length> column-spacing: 16px;
    out property <length> board-padding: 16px;
    out property <length> card-height: 140px;
}

export global UserGlobal {
    in-out property <[string]> users: ["user"];
    in-out property <string> active-user: "user";
    in-out property <bool> show-only-mine: false;
    callback change-active-user(string);
    callback toggle-show-only-mine(bool);
}

export component IdCopy inherits Rectangle {
    in property <string> id;
    in property <length> font-size: 11px;

    width: layout.preferred-width;
    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? #0052cc10 : transparent;

    touch := TouchArea { }

    layout := HorizontalLayout {
        padding: 2px;
        spacing: 4px;
        alignment: start;

        label := Text {
            text: "#" + root.id;
            font-size: root.font-size;
            font-weight: 700;
            color: #0052cc;
            vertical-alignment: center;
        }

        // Hidden TextEdit for copy functionality.
        // It must be visible (though size 0) to allow copying.
        edit := TextEdit {
            text: "#" + root.id;
            read-only: true;
            width: 0px;
            height: 0px;
            opacity: 0;
        }

        Button {
            text: "📋";
            width: 24px;
            height: 24px;
            clicked => {
                edit.focus();
                edit.select-all();
                edit.copy();
            }
        }
    }
}
