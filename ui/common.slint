import { TextEdit, Button, Palette } from "std-widgets.slint";

export struct RefStr {
    id: string,
    title: string,
}

export struct CommentStr {
    id: string,
    author: string,
    created_at: string,
    updated_at: string,
    content: string,
    references: [RefStr],
}

export struct TicketStr {
    id: string,
    title: string,
    description: string,
    snippet: string,
    created_at: string,
    updated_at: string,
    assigned_to: string,
    author: string,
    references: [RefStr],
    comments: [CommentStr],
    attachment_count: int,
    points: int,
}

export struct QueueStr {
    id: string,
    name: string,
    tickets: [TicketStr],
    limit: int,           // -1 means no limit
    ticket_count: int,
    total_points: int,
    visible: bool,
}

export struct QueueStatStr {
    name: string,
    count: int,
    limit: string,
    usage: string,
}

export struct UserStatStr {
    name: string,
    count: int,
}

export struct TrendPointStr {
    timestamp: string,
    total_tickets: int,
    done_tickets: int,
    total_points: int,
    done_points: int,
}

export struct BoardSummaryStr {
    total_tickets: int,
    unassigned_tickets: int,
    queues: [QueueStatStr],
    users: [UserStatStr],
    total_points: int,
    total_done_points: int,
    points_completion_rate: string,
    avg_lead_time: string,
    avg_cycle_time: string,
    completion_rate: string,
    sprint_completion_rate: string,
    
    // Numeric values for progress bars
    f_completion_rate: float,
    f_points_completion_rate: float,
    f_sprint_completion_rate: float,
    
    trend: [TrendPointStr],
}

export struct SprintStr {
    number: int,
    name: string,
    start_date: string,
    end_date: string,
}

// Centralized color palette for the application.
// Use these instead of hardcoded hex values for consistency.
export global Theme {
    out property <color> id-color: #0052cc;
    out property <color> id-hover-bg: #0052cc10;
    out property <color> author-color: #d33682;
    out property <color> danger: #ff4444;
    out property <color> warning: #ff9800;
    out property <color> success: #4caf50;
    out property <color> delete-hover: #ff0048;
    out property <color> delete-active: #eb1aba;
    out property <color> backdrop: #00000080;
    out property <color> shadow: #00000040;

    // Points color scale
    out property <color> point-0: #808080bc;
    out property <color> point-1: #4caf4fce;
    out property <color> point-2: #8BC34A;
    out property <color> point-3: #ccdc39cf;
    out property <color> point-4: #dce775b8;
    out property <color> point-5: #ffeb3bb3;
    out property <color> point-6: #ffc107cb;
    out property <color> point-7: #ff9900cd;
    out property <color> point-8: #f44336ce;
    out property <color> point-9: #d32f2fd6;
    out property <color> point-10: #9b27b0cc;
}

export component AppConfig {
    out property <length> column-width: 280px;
    out property <length> column-spacing: 16px;
    out property <length> board-padding: 16px;
    out property <length> card-height: 140px;
}

export global UserGlobal {
    in-out property <[string]> users: ["user"];
    in-out property <string> active-user: "user";
    in-out property <bool> show-only-mine: false;
    callback change-active-user(string);
    callback toggle-show-only-mine(bool);
}

// Reusable "×" close/delete button with hover effects.
export component CloseButton inherits Rectangle {
    callback clicked();
    in property <length> size: 24px;

    width: size;
    height: size;
    border-radius: 4px;
    background: touch.pressed ? Theme.delete-active : (touch.has-hover ? Theme.delete-hover : transparent);

    Text {
        text: "×";
        font-size: root.size * 0.75;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: touch.has-hover ? white : Palette.foreground;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Semi-transparent backdrop for modal dialogs.
// Clicking the backdrop triggers dismiss(); child content is placed on top.
export component ModalBackdrop inherits Rectangle {
    callback dismiss();

    background: Theme.backdrop;

    TouchArea {
        clicked => {
            dismiss();
        }
    }

    @children
}

export component IdCopy inherits Rectangle {
    in property <string> id;
    in property <length> font-size: 11px;

    width: layout.preferred-width;
    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.id-hover-bg : transparent;

    touch := TouchArea { }

    layout := HorizontalLayout {
        padding: 2px;
        spacing: 4px;
        alignment: start;

        label := Text {
            text: "#" + root.id;
            font-size: root.font-size;
            font-weight: 700;
            color: Theme.id-color;
            vertical-alignment: center;
        }

        // Hidden TextEdit for copy functionality.
        // It must be visible (though size 0) to allow copying.
        edit := TextEdit {
            text: "#" + root.id;
            read-only: true;
            width: 0px;
            height: 0px;
            opacity: 0;
        }

        Button {
            text: "📋";
            width: 24px;
            height: 24px;
            clicked => {
                edit.focus();
                edit.select-all();
                edit.copy();
            }
        }
    }
}
