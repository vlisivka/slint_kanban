import {
    ScrollView,
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    TextEdit,
    Palette,
    CheckBox,
    ComboBox,
} from "std-widgets.slint";

import {
    RefStr,
    TicketStr,
    QueueStr,
    AppConfig,
    UserGlobal,
} from "common.slint";

export { UserGlobal }
import { TicketView } from "dialogs/ticket_view.slint";
import { TicketEdit } from "dialogs/ticket_edit.slint";
import { WarningDialog } from "dialogs/warning_dialog.slint";
import { QueueLimitEdit } from "dialogs/queue_limit_edit.slint";
import { FilterMenu } from "dialogs/filter_menu.slint";
import { SearchHistoryMenu } from "dialogs/search_history_menu.slint";
import { TicketCard } from "components/ticket_card.slint";
import { KanbanColumn } from "components/kanban_column.slint";

export component App inherits Window {
    in-out property <[QueueStr]> board_queues;
    in-out property <string> search_query: "";
    in-out property <string> date_from: "";
    in-out property <string> date_to: "";
    in-out property <[string]> search_history: [];
    in-out property <bool> show_search_history: false;
    in-out property <bool> show_filter_menu: false;
    callback search_edited(string);
    callback accept_search(string);
    callback select_history_item(string);
    callback remove_search_item(string);
    callback date_filter_changed();
    callback focus_search();
    callback show_board_info();
    callback shortcut_create_ticket();
    callback toggle_queue_visibility(string, bool);
    callback move_ticket(string, string, string); // ticket_id, from_queue, index:...
    callback delete_ticket(string);
    callback save_ticket(string, string, string, string); // id, title, desc, assigned_to
    callback request_create_ticket(string, string, string, string); // queue_id, title, desc, assigned_to
    callback request_change_limit(string, int); // queue_id, limit
    callback show_warning_dialog(string); // message
    callback navigate_to(string); // for cross-references
    callback test_trigger_add_ticket(string); // for testing
    callback test_trigger_close_view(); // for testing
    callback test_trigger_cancel_edit(); // for testing
    callback test_trigger_delete_ticket(string); // for testing
    callback test_trigger_select_history(string); // for testing
    callback test_trigger_remove_history(string); // for testing
    // Tooltip state
    out property <string> tooltip_text: "";
    out property <bool> tooltip_visible: false;
    property <length> tooltip_x: 0px;
    property <length> tooltip_y: 0px;

    // Global dragging state
    property <string> dragging_ticket_id: "";
    property <string> dragging_from_queue_id: "";
    in-out property <bool> is_dragging: false;
    property <length> mouse_x: 0px;
    property <length> mouse_y: 0px;

    // State
    in-out property <bool> is_viewing_ticket: false;
    in-out property <TicketStr> active_ticket;

    // Editing state
    in-out property <bool> is_editing: false;
    in-out property <string> editing_id: "";
    in-out property <string> editing_title: "";
    in-out property <string> editing_desc: "";
    in-out property <string> editing_assigned_to: "";
    in-out property <string> editing_author: "";
    in-out property <string> target_queue_for_new: "";

    // Warning dialog state
    in-out property <bool> show_warning: false;
    out property <string> warning_message: "";

    // Limit editing state
    property <bool> is_editing_limit: false;
    property <string> editing_limit_id: "";
    property <string> editing_limit_name: "";
    property <string> editing_limit_text: "";

    preferred-width: 1024px;
    preferred-height: 768px;
    min-width: 400px;
    min-height: 300px;

    title: "Slint Kanban";
    forward-focus: focus_scope;

    init => {
        focus_scope.focus();
    }

    config := AppConfig { }

    focus_scope := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "f" || event.text == "F" || event.text == "а" || event.text == "А") {
                    search-input.focus();
                    focus_search();
                    return accept;
                }
                if (event.text == "n" || event.text == "N" || event.text == "т" || event.text == "Т") {
                    shortcut_create_ticket();
                    return accept;
                }
                if (event.text == "m" || event.text == "M" || event.text == "ь" || event.text == "Ь") {
                    UserGlobal.toggle-show-only-mine(!UserGlobal.show-only-mine);
                    return accept;
                }
            }
            if (event.text == Key.Escape) {
                if (show_warning) {
                    show_warning = false;
                    return accept;
                }
                if (is_editing_limit) {
                    is_editing_limit = false;
                    return accept;
                }
                if (is_editing) {
                    is_editing = false;
                    return accept;
                }
                if (is_viewing_ticket) {
                    is_viewing_ticket = false;
                    return accept;
                }
                if (show_search_history) {
                    show_search_history = false;
                    return accept;
                }
                if (show_filter_menu) {
                    show_filter_menu = false;
                    return accept;
                }
                if (search_query != "") {
                    search_query = "";
                    search_edited("");
                    return accept;
                }
            }
            reject
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            // Search Header
            Rectangle {
                height: 60px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 20px;

                    // Left spacer for layout balance
                    Rectangle {
                        width: 40px;
                    }

                    HorizontalBox {
                        spacing: 12px;
                        alignment: center;

                        Text {
                            text: "Search:";
                            vertical-alignment: center;
                            font-weight: 700;
                        }

                        Rectangle {
                            width: 400px;
                            search-input := LineEdit {
                                width: 100%;
                                text <=> search_query;
                                placeholder-text: "Filter titles, descriptions or IDs...";
                                edited(text) => {
                                    search_edited(text);
                                }
                                accepted(text) => {
                                    accept_search(text);
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.DownArrow) {
                                        show_search_history = true;
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        search_query = "";
                                        search_edited("");
                                        focus_scope.focus();
                                        return accept;
                                    }
                                    reject
                                }
                            }

                            if (search_query != ""): Rectangle {
                                x: parent.width - self.width - 8px;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: clear-touch.pressed ? #ccc : clear-touch.has-hover ? #ddd : transparent;
                                Text {
                                    text: "✕";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    font-size: 12px;
                                }

                                clear-touch := TouchArea {
                                    clicked => {
                                        search_query = "";
                                        search_edited("");
                                    }
                                }
                            }
                        }

                        history-btn := Button {
                            text: "History";
                            clicked => {
                                show_search_history = !show_search_history;
                            }
                        }

                        Button {
                            text: "Board Info";
                            clicked => {
                                show_board_info();
                            }
                        }
                    }

                    // Right aligned filter button
                    HorizontalLayout {
                        alignment: end;
                        padding-right: 15px;
                        settings-btn := Button {
                            text: "⚙"; // Gear icon for settings/filter
                            width: 40px;
                            clicked => {
                                show_filter_menu = !show_filter_menu;
                            }
                        }
                    }
                }
            }

            ScrollView {
                columns-row := HorizontalLayout {
                    padding: config.board-padding;
                    spacing: config.column-spacing;
                    alignment: start;

                    for queue in board_queues: KanbanColumn {
                        visible: queue.visible;
                        queue: queue;
                        width: self.visible ? config.column-width : 0px;

                        start_dragging(tid, qid, mx, my) => {
                            dragging_ticket_id = tid;
                            dragging_from_queue_id = qid;
                            mouse_x = mx;
                            mouse_y = my;
                            is_dragging = true;
                        }
                        move_dragging(mx, my) => {
                            mouse_x = mx;
                            mouse_y = my;
                        }
                        drop_ticket(mx) => {
                            if (is_dragging) {
                                is_dragging = false;
                                let relative_x = mx - columns-row.absolute-position.x;
                                if (relative_x > config.board-padding) {
                                    let idx = (relative_x - config.board-padding) / (config.column-width + config.column-spacing);
                                    move_ticket(dragging_ticket_id, dragging_from_queue_id, "index:" + idx);
                                }
                                dragging_ticket_id = "";
                                dragging_from_queue_id = "";
                            }
                        }
                        delete_ticket(tid) => {
                            delete_ticket(tid);
                        }
                        edit_ticket(t) => {
                            active_ticket = t;
                            is_viewing_ticket = true;
                        }
                        create_ticket(qid) => {
                            editing_id = "";
                            editing_title = "New Ticket";
                            editing_desc = "";
                            editing_assigned_to = (UserGlobal.active-user == "<unassigned>") ? "" : UserGlobal.active-user;
                            editing_author = (UserGlobal.active-user == "<unassigned>") ? "" : UserGlobal.active-user;
                            target_queue_for_new = qid;
                            is_editing = true;
                        }
                        edit_limit(qid, qname, qlimit) => {
                            editing_limit_id = qid;
                            editing_limit_name = qname;
                            editing_limit_text = qlimit > 0 ? qlimit : "";
                            is_editing_limit = true;
                        }
                    }
                }
            }
        }
    }

    // Warning dialog handler
    show_warning_dialog(msg) => {
        warning_message = msg;
        show_warning = true;
    }

    test_trigger_add_ticket(qid) => {
        editing_id = "";
        editing_title = "New Ticket";
        editing_desc = "";
        editing_assigned_to = "";
        editing_author = (UserGlobal.active-user == "<unassigned>") ? "" : UserGlobal.active-user;
        target_queue_for_new = qid;
        is_editing = true;
    }

    test_trigger_close_view() => {
        is_viewing_ticket = false;
    }

    test_trigger_cancel_edit() => {
        is_editing = false;
    }

    test_trigger_delete_ticket(tid) => {
        delete_ticket(tid);
    }

    test_trigger_select_history(q) => {
        search_query = q;
        select_history_item(q);
    }

    test_trigger_remove_history(q) => {
        remove_search_item(q);
    }

    // Drag ghost: floating card that follows the cursor during drag
    if (is_dragging): Rectangle {
        x: mouse_x - 100px;
        y: mouse_y - 30px;
        width: 200px;
        height: 60px;
        border-radius: 4px;
        border-width: 2px;

        Text {
            text: "Moving #" + dragging_ticket_id;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Ticket View Overlay
    if (is_viewing_ticket): TicketView {
        ticket: active_ticket;
        close => {
            is_viewing_ticket = false;
        }
        edit => {
            is_viewing_ticket = false;
            editing_id = active_ticket.id;
            editing_title = active_ticket.title;
            editing_desc = active_ticket.description;
            editing_assigned_to = active_ticket.assigned_to;
            editing_author = active_ticket.author;
            is_editing = true;
        }
        navigate_to(target) => {
            navigate_to(target);
        }
        show_tooltip(text, x, y) => {
            tooltip_text = text;
            tooltip_x = x;
            tooltip_y = y;
            tooltip_visible = true;
        }
        hide_tooltip() => {
            tooltip_visible = false;
        }
    }

    // Edit Overlay
    if (is_editing): TicketEdit {
        ticket_id: editing_id;
        title_text: editing_title;
        description_text: editing_desc;
        assigned_to: editing_assigned_to;
        author: editing_author;
        users: UserGlobal.users;

        cancel => {
            is_editing = false;
        }
        save(id, title, desc, assigned) => {
            is_editing = false;
            if (id == "") {
                request_create_ticket(target_queue_for_new, title, desc, assigned);
            } else {
                save_ticket(id, title, desc, assigned);
            }
        }
    }

    // Warning Dialog Overlay
    if (show_warning): WarningDialog {
        message: warning_message;
        close => {
            show_warning = false;
        }
    }

    // Limit Edit Overlay
    if (is_editing_limit): QueueLimitEdit {
        queue_id: editing_limit_id;
        queue_name: editing_limit_name;
        limit_text: editing_limit_text;

        cancel => {
            is_editing_limit = false;
        }
        remove_limit(qid) => {
            is_editing_limit = false;
            request_change_limit(qid, -1);
        }
        save(qid, limit) => {
            is_editing_limit = false;
            request_change_limit(qid, limit);
        }
    }

    // Filter Menu Overlay
    if (show_filter_menu): FilterMenu {
        x: parent.width - self.width - 20px; // Top Right
        y: 70px; // Below header
        width: 250px;
        height: self.preferred-height;
        queues: board_queues;
        date_from <=> root.date_from;
        date_to <=> root.date_to;
        close => {
            show_filter_menu = false;
        }
        toggle_visibility(qid, visible) => {
            toggle_queue_visibility(qid, visible);
        }
        date_filter_changed => {
            root.date_filter_changed();
        }
    }

    // Search History Menu Overlay
    if (show_search_history): SearchHistoryMenu {
        x: (parent.width - self.width) / 2;
        y: 70px; // Below header
        width: 400px;
        history: search_history;
        select_search(query) => {
            show_search_history = false;
            search_query = query;
            select_history_item(query);
        }
        remove_search(query) => {
            remove_search_item(query);
        }
        close => {
            show_search_history = false;
        }
    }

    // Floating Tooltip
    if (tooltip_visible): Rectangle {
        x: tooltip_x;
        y: tooltip_y;
        width: tooltip_label.preferred-width + 16px;
        height: tooltip_label.preferred-height + 8px;
        background: #333333;
        border-radius: 4px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
        z: 100;

        tooltip_label := Text {
            text: tooltip_text;
            color: white;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
