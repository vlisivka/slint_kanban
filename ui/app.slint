import { ScrollView, VerticalBox, HorizontalBox, Button, LineEdit, TextEdit, Palette, CheckBox } from "std-widgets.slint";

export struct RefStr {
    id: string,
    title: string,
}

export struct TicketStr {
    id: string,
    title: string,
    description: string,
    snippet: string,
    created_at: string,
    updated_at: string,
    references: [RefStr],
}

export struct QueueStr {
    id: string,
    name: string,
    tickets: [TicketStr],
    limit: int,           // -1 means no limit
    ticket_count: int,
    visible: bool,
}

component AppConfig {
    out property <length> column-width: 280px;
    out property <length> column-spacing: 16px;
    out property <length> board-padding: 16px;
    out property <length> card-height: 140px;
}

component TicketView inherits Rectangle {
    in property <TicketStr> ticket;
    callback close();
    callback edit();
    callback navigate_to(string);
    callback show_tooltip(string, length, length);
    callback hide_tooltip();
 
    background: #00000080; // Semi-transparent backdrop for focus
    
    // BACKDROP: Catch clicks outside the card to cancel
    TouchArea {
        clicked => { close(); }
    }
    
    Rectangle {
        // Full window (fill parent)
        width: 100%;
        height: 100%;
        background: Palette.background;
        
        TouchArea { } // Block clicks

        VerticalBox {
            padding: 40px;
            spacing: 24px;
            
            HorizontalLayout {
                padding: 0px;
                alignment: space-between;
                
                Button {
                    text: "Edit";
                    width: 100px;
                    height: 40px;
                    clicked => { edit(); }
                }

                // Title as header (centered)
                Text {
                    text: ticket.title;
                    font-size: 32px;
                    font-weight: 800;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    // Centering logic: this text fills the space between buttons
                }
                
                Button {
                    text: "Close";
                    width: 100px;
                    height: 40px;
                    clicked => { close(); }
                }
            }
            
            
            ScrollView {
                VerticalBox {
                    padding: 20px;
                    spacing: 20px;
                    Text {
                        text: ticket.description;
                        font-size: 18px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }

                    if ticket.references.length > 0 : VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Related Tickets:";
                            font-size: 16px;
                            font-weight: 800;
                            opacity: 0.7;
                        }
                        HorizontalBox {
                            padding: 0px;
                            alignment: start;
                            for ref in ticket.references : Rectangle {
                                width: ref_label.preferred-width + 20px;
                                height: 32px;
                                border-radius: 4px;
                                background: Palette.alternate-background;
                                
                                ref_label := Text {
                                    text: ref.id;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { navigate_to(ref.id); }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            show_tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                        } else {
                                            hide_tooltip();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component TicketEdit inherits Rectangle {
    in-out property <string> title_text;
    in-out property <string> description_text;
    in property <string> ticket_id;
    
    callback save(string, string, string); // id, title, desc
    callback cancel();
 
    background: #00000080; // Semi-transparent backdrop for focus
    
    // BACKDROP: Catch clicks outside the card to cancel
    TouchArea {
        clicked => { cancel(); }
    }
    
    Rectangle {
        // Full window (fill parent)
        width: 100%;
        height: 100%;
        background: Palette.background;
        
        TouchArea { } // Block clicks

        VerticalBox {
            padding: 40px;
            spacing: 24px;
            
            HorizontalLayout {
                padding: 0px;
                alignment: space-between;
                
                Button {
                    text: "Cancel";
                    width: 100px;
                    height: 40px;
                    clicked => { cancel(); }
                }

                // Title as header (centered)
                Text {
                    text: ticket_id == "" ? "Create New Ticket" : "Edit Ticket #" + ticket_id;
                    font-size: 32px;
                    font-weight: 800;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                
                Button {
                    text: "Save Ticket";
                    primary: true;
                    width: 120px;
                    height: 40px;
                    clicked => { save(ticket_id, title_text, description_text); }
                }
            }
            
            VerticalLayout {
                spacing: 8px;
                Text { text: "Title"; font-size: 11px; font-weight: 800; opacity: 0.6; }
                LineEdit {
                    text <=> title_text;
                    placeholder-text: "What needs to be done?";
                    height: 40px;
                }
            }
            
            VerticalLayout {
                spacing: 8px;
                Text { text: "Description"; font-size: 11px; font-weight: 800; opacity: 0.6; }
                TextEdit {
                    text <=> description_text;
                    placeholder-text: "What needs to be done?";
                    preferred-height: 400px;
                    vertical-stretch: 1;
                }
            }
        }
    }
}

component WarningDialog inherits Rectangle {
    in property <string> message;
    callback close();
    
    background: #00000080; // Semi-transparent backdrop
    
    // BACKDROP: Catch clicks outside to close
    TouchArea {
        clicked => { close(); }
    }
    
    Rectangle {
        width: 400px;
        height: 200px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.background;
        border-radius: 12px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        
        TouchArea { } // Block clicks
        
        VerticalBox {
            padding: 24px;
            spacing: 20px;
            
            // Warning Icon and Title
            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: #ff9800;
                    
                    Text {
                        text: "⚠";
                        font-size: 32px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                
                Text {
                    text: "Warning";
                    font-size: 20px;
                    font-weight: 700;
                }
            }
            
            // Message
            Text {
                text: message;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            
            // Close Button
            Button {
                text: "OK";
                primary: true;
                clicked => { close(); }
            }
        }
    }
}

component QueueLimitEdit inherits Rectangle {
    in property <string> queue_name;
    in property <string> queue_id;
    in-out property <string> limit_text;
    
    callback save(string, int); // id, limit
    callback cancel();
    callback remove_limit(string); // id
  
    background: #00000080; // Semi-transparent backdrop
    
    // BACKDROP: Catch clicks outside to cancel
    TouchArea {
        clicked => { cancel(); }
    }
    
    Rectangle {
        width: 400px;
        height: 280px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.background;
        border-radius: 12px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        
        TouchArea { } // Block clicks
        
        VerticalBox {
            padding: 24px;
            spacing: 20px;
            
            Text {
                text: "Set Limit for " + queue_name;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            
            VerticalLayout {
                spacing: 8px;
                Text { text: "Max Tickets"; font-size: 11px; font-weight: 800; opacity: 0.6; }
                LineEdit {
                    text <=> limit_text;
                    placeholder-text: "e.g. 5, 21";
                    height: 40px;
                    input-type: number;
                }
            }
            
            HorizontalLayout {
                spacing: 12px;
                Button {
                    text: "Cancel";
                    clicked => { cancel(); }
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Remove Limit";
                    clicked => { remove_limit(queue_id); }
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Save";
                    primary: true;
                    clicked => { save(queue_id, limit_text.to-float()); }
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

component TicketCard inherits Rectangle {
    in property <TicketStr> ticket;
    in property <string> from_queue_id;
    
    // Drag/Delete/Edit callbacks
    callback start_dragging(string, string, length, length);
    callback move_dragging(length, length);
    callback drop_ticket(length);
    callback delete_clicked(string);
    callback edit_clicked(TicketStr);

    border-radius: 8px;
    border-width: 1px;
    height: 140px;
    drop-shadow-blur: touch-area.has-hover ? 8px : 2px;
    drop-shadow-offset-y: touch-area.has-hover ? 4px : 1px;
    drop-shadow-color: #00000020;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: 150ms; }

    // Drag-and-Drop Area
    touch-area := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                 start_dragging(ticket.id, from_queue_id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (event.kind == PointerEventKind.up) {
                 drop_ticket(self.absolute-position.x + self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                move_dragging(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
             // If not dragging, open for edit
             edit_clicked(ticket);
        }
    }

    VerticalBox {
        padding: 12px;
        spacing: 8px;
        
        HorizontalBox {
            padding: 0px;
            alignment: space-between;
            
            Text {
                text: ticket.title;
                font-weight: 700;
                font-size: 15px;
                overflow: elide;
            }
            
            // Delete Button
            Rectangle {
                width: 24px;
                height: 24px;
                background: touch-del.pressed ? #eb1abaff : (touch-del.has-hover ? #ff0048ff : transparent);
                border-radius: 4px;
                
                Text {
                    text: "×";
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                touch-del := TouchArea {
                    clicked => { delete_clicked(ticket.id); }
                }
            }
        }
        
        Text {
            text: ticket.snippet;
            font-size: 13px;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            Text {
                text: "#" + ticket.id;
                font-size: 11px;
                font-weight: 700;
                color: #5e6c84;
                opacity: 0.6;
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "C: " + ticket.created_at;
                    font-size: 9px;
                }
                Text {
                    text: "U: " + ticket.updated_at;
                    font-size: 9px;
                }
            }
        }
    }
}

component FilterMenu inherits Rectangle {
    in-out property <[QueueStr]> queues;
    callback toggle_visibility(string, bool);
    callback close();

    background: Palette.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    drop-shadow-blur: 15px;
    drop-shadow-color: #00000040;

    height: self.preferred-height;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Visible Queues";
                font-size: 16px;
                font-weight: 700;
            }
        }

        VerticalLayout {
            spacing: 10px;
            for q in queues : HorizontalLayout {
                spacing: 10px;
                CheckBox {
                    text: q.name;
                    checked: q.visible;
                    toggled => { toggle_visibility(q.id, self.checked); }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => { close(); }
            }
        }
    }
}

component KanbanColumn inherits Rectangle {
    in property <QueueStr> queue;
    
    // Drag/Drop/Delete/Edit callbacks
    callback start_dragging(string, string, length, length);
    callback move_dragging(length, length);
    callback drop_ticket(length);
    callback delete_ticket(string);
    callback edit_ticket(TicketStr);
    callback create_ticket(string); // queue_id
    callback edit_limit(string, string, int); // id, name, current_limit

    width: 280px; // Matching AppConfig.column-width
    horizontal-stretch: 0; // Prevent shrinking in layouts
    border-radius: 12px;
    background: Palette.alternate-background;
    
    VerticalBox {
        padding: 16px;
        spacing: 12px;
        
        HorizontalBox {
             padding: 0px;
             alignment: space-between;
             
             VerticalLayout {
                 Text {
                     text: queue.name;
                     font-weight: 800;
                     font-size: 16px;
                 }
             }
             
                  // Limit Indicators and Settings
                  HorizontalLayout {
                      spacing: 8px;
                      alignment: end;

                      // Styled New Ticket Button first
                      Rectangle {
                          width: 32px;
                          height: 32px;
                          border-radius: 16px;
                          
                          Text {
                              text: "+";
                              font-size: 20px;
                              font-weight: 800;
                              horizontal-alignment: center;
                              vertical-alignment: center;
                          }
                          
                          touch-add := TouchArea {
                              clicked => { create_ticket(queue.id); }
                          }
                      }
                      
                      // Limit Badge (clickable)
                      if queue.limit > 0 : TouchArea {
                          clicked => { edit_limit(queue.id, queue.name, queue.limit); }
                          
                          Rectangle {
                              height: 24px;
                              min-width: 50px;
                              border-radius: 12px;
                              background: {
                                  if queue.ticket_count >= queue.limit {
                                      #ff4444  // Red when at limit
                                  } else if queue.ticket_count >= queue.limit * 80 / 100 {
                                      #ff9800  // Orange when >= 80%
                                  } else {
                                      #4caf50  // Green when normal
                                  }
                              };
                              
                              Text {
                                  text: queue.ticket_count + "/" + queue.limit;
                                  font-size: 12px;
                                  font-weight: 700;
                                  color: white;
                                  horizontal-alignment: center;
                                  vertical-alignment: center;
                              }
                          }
                      }

                      // Gear icon if no limit, to allow setting one
                      if queue.limit <= 0 : Rectangle {
                          width: 32px;
                          height: 32px;
                          border-radius: 16px;
                          opacity: touch-limit-none.has-hover ? 1.0 : 0.3;
                          
                          Text {
                              text: "⚙";
                              font-size: 16px;
                              horizontal-alignment: center;
                              vertical-alignment: center;
                          }
                          
                          touch-limit-none := TouchArea {
                              clicked => { edit_limit(queue.id, queue.name, -1); }
                          }
                      }
                  }
              }
         
         ScrollView {
            VerticalLayout {
                spacing: 10px;
                for ticket in queue.tickets : TicketCard {
                    ticket: ticket;
                    from_queue_id: queue.id;
                    start_dragging(tid, qid, mx, my) => { start_dragging(tid, qid, mx, my); }
                    move_dragging(mx, my) => { move_dragging(mx, my); }
                    drop_ticket(mx) => { drop_ticket(mx); }
                    delete_clicked(tid) => { delete_ticket(tid); }
                    edit_clicked(t) => { edit_ticket(t); }
                }
            }
        }
    }
}

export component App inherits Window {
    in-out property <[QueueStr]> board_queues;
    in-out property <string> search_query: "";
    in-out property <bool> show_filter_menu: false;
    callback search_edited(string);
    callback toggle_queue_visibility(string, bool);
    callback move_ticket(string, string, string); // ticket_id, from_queue, index:...
    callback delete_ticket(string);
    callback save_ticket(string, string, string); // id, title, desc
    callback request_create_ticket(string, string, string); // queue_id, title, desc
    callback request_change_limit(string, int); // queue_id, limit
    callback show_warning_dialog(string); // message
    callback navigate_to(string); // for cross-references
    callback test_trigger_add_ticket(string); // for testing
    callback test_trigger_close_view(); // for testing
    callback test_trigger_cancel_edit(); // for testing
    callback test_trigger_delete_ticket(string); // for testing
    // Tooltip state
    property <string> tooltip_text: "";
    property <bool> tooltip_visible: false;
    property <length> tooltip_x: 0px;
    property <length> tooltip_y: 0px;

    // Global dragging state
    property <string> dragging_ticket_id: "";
    property <string> dragging_from_queue_id: "";
    in-out property <bool> is_dragging: false;
    property <length> mouse_x: 0px;
    property <length> mouse_y: 0px;

    // State
    in-out property <bool> is_viewing_ticket: false;
    in-out property <TicketStr> active_ticket;

    // Editing state
    in-out property <bool> is_editing: false;
    out property <string> editing_id: "";
    out property <string> editing_title: "";
    out property <string> editing_desc: "";
    out property <string> target_queue_for_new: "";
    
    // Warning dialog state
    property <bool> show_warning: false;
    property <string> warning_message: "";

    // Limit editing state
    property <bool> is_editing_limit: false;
    property <string> editing_limit_id: "";
    property <string> editing_limit_name: "";
    property <string> editing_limit_text: "";

    preferred-width: 1024px;
    preferred-height: 768px;
    min-width: 400px;
    min-height: 300px;
    
    title: "Slint Kanban";

    config := AppConfig {}

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Search Header
        Rectangle {
            height: 60px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 10px;
                spacing: 20px;
                
                // Left spacer to balance if needed, or just alignment
                Rectangle { width: 40px; } 

                HorizontalBox {
                    spacing: 12px;
                    alignment: center;
                    
                    Text {
                        text: "Search:";
                        vertical-alignment: center;
                        font-weight: 700;
                    }
                    
                    LineEdit {
                        text <=> search_query;
                        placeholder-text: "Filter titles, descriptions or IDs...";
                        width: 400px;
                        edited(text) => { search_edited(text); }
                    }
                    
                    if (search_query != "") : Button {
                        text: "Clear";
                        clicked => { search_query = ""; search_edited(""); }
                    }
                }

                // Right aligned filter button
                HorizontalLayout {
                    alignment: end;
                    padding-right: 15px;
                    Button {
                        text: "⚙"; // Gear icon for settings/filter
                        width: 40px;
                        clicked => { show_filter_menu = !show_filter_menu; }
                    }
                }
            }
        }

        ScrollView {
            HorizontalLayout {
            padding: config.board-padding;
            spacing: config.column-spacing;
            alignment: start;
            
            for queue in board_queues : KanbanColumn {
                visible: queue.visible;
                queue: queue;
                width: self.visible ? config.column-width : 0px;
                
                start_dragging(tid, qid, mx, my) => {
                    dragging_ticket_id = tid;
                    dragging_from_queue_id = qid;
                    mouse_x = mx;
                    mouse_y = my;
                    is_dragging = true;
                }
                move_dragging(mx, my) => {
                    mouse_x = mx;
                    mouse_y = my;
                }
                drop_ticket(mx) => {
                    if (is_dragging) {
                        is_dragging = false;
                        if (mx > config.board-padding) {
                            let idx = (mx - config.board-padding) / (config.column-width + config.column-spacing);
                            move_ticket(dragging_ticket_id, dragging_from_queue_id, "index:" + idx);
                        }
                        dragging_ticket_id = "";
                        dragging_from_queue_id = "";
                    }
                }
                delete_ticket(tid) => {
                    delete_ticket(tid);
                }
                edit_ticket(t) => {
                    active_ticket = t;
                    is_viewing_ticket = true;
                }
                create_ticket(qid) => {
                    editing_id = "";
                    editing_title = "New Ticket";
                    editing_desc = "";
                    target_queue_for_new = qid;
                    is_editing = true;
                }
                edit_limit(qid, qname, qlimit) => {
                    editing_limit_id = qid;
                    editing_limit_name = qname;
                    editing_limit_text = qlimit > 0 ? qlimit : "";
                    is_editing_limit = true;
                }
            }
        }
    }
    }
    
    // Initialize callback
    show_warning_dialog(msg) => {
        warning_message = msg;
        show_warning = true;
    }
    
    test_trigger_add_ticket(qid) => {
        editing_id = "";
        editing_title = "New Ticket";
        editing_desc = "";
        target_queue_for_new = qid;
        is_editing = true;
    }

    test_trigger_close_view() => {
        is_viewing_ticket = false;
    }

    test_trigger_cancel_edit() => {
        is_editing = false;
    }

    test_trigger_delete_ticket(tid) => {
        delete_ticket(tid);
    }

    // Ghost card follows mouse
    if (is_dragging) : Rectangle {
        x: mouse_x - 100px;
        y: mouse_y - 30px;
        width: 200px;
        height: 60px;
        border-radius: 4px;
        border-width: 2px;
        
        Text {
             text: "Moving #" + dragging_ticket_id;
             font-weight: 700;
             horizontal-alignment: center;
             vertical-alignment: center;
        }
    }

    // Ticket View Overlay
    if (is_viewing_ticket) : TicketView {
        ticket: active_ticket;
        close => { is_viewing_ticket = false; }
        edit => {
            is_viewing_ticket = false;
            editing_id = active_ticket.id;
            editing_title = active_ticket.title;
            editing_desc = active_ticket.description;
            is_editing = true;
        }
        navigate_to(target) => { navigate_to(target); }
        show_tooltip(text, x, y) => {
            tooltip_text = text;
            tooltip_x = x;
            tooltip_y = y;
            tooltip_visible = true;
        }
        hide_tooltip() => {
            tooltip_visible = false;
        }
    }

    // Edit Overlay
    if (is_editing) : TicketEdit {
        ticket_id: editing_id;
        title_text: editing_title;
        description_text: editing_desc;
        
        cancel => { is_editing = false; }
        save(id, title, desc) => {
            is_editing = false;
            if (id == "") {
                request_create_ticket(target_queue_for_new, title, desc);
            } else {
                save_ticket(id, title, desc);
            }
        }
    }
    
    // Warning Dialog Overlay
    if (show_warning) : WarningDialog {
        message: warning_message;
        close => { show_warning = false; }
    }

    // Limit Edit Overlay
    if (is_editing_limit) : QueueLimitEdit {
        queue_id: editing_limit_id;
        queue_name: editing_limit_name;
        limit_text: editing_limit_text;
        
        cancel => { is_editing_limit = false; }
        remove_limit(qid) => {
            is_editing_limit = false;
            request_change_limit(qid, -1);
        }
        save(qid, limit) => {
            is_editing_limit = false;
            request_change_limit(qid, limit);
        }
    }

    // Filter Menu Overlay
    if (show_filter_menu) : FilterMenu {
        x: parent.width - self.width - 20px; // Top Right
        y: 70px; // Below header
        width: 250px;
        height: self.preferred-height;
        queues: board_queues;
        close => { show_filter_menu = false; }
        toggle_visibility(qid, visible) => { toggle_queue_visibility(qid, visible); }
    }

    // Floating Tooltip
    if (tooltip_visible) : Rectangle {
        x: tooltip_x;
        y: tooltip_y;
        width: tooltip_label.preferred-width + 16px;
        height: tooltip_label.preferred-height + 8px;
        background: #333333;
        border-radius: 4px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
        z: 100; // Ensure it's on top
        
        tooltip_label := Text {
            text: tooltip_text;
            color: white;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
