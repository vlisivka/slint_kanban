import {
    ScrollView,
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    TextEdit,
    Palette,
    CheckBox,
    ComboBox,
} from "std-widgets.slint";

import {
    RefStr,
    TicketStr,
    QueueStr,
    AppConfig,
    UserGlobal,
    BoardSummaryStr,
    SprintStr,
    Clipboard,
    Api,
} from "common.slint";

export { UserGlobal, Clipboard, Api }
import { TicketView } from "dialogs/ticket_view.slint";
import { TicketEdit } from "dialogs/ticket_edit.slint";
import { WarningDialog } from "dialogs/warning_dialog.slint";
import { QueueLimitEdit } from "dialogs/queue_limit_edit.slint";
import { FilterMenu } from "dialogs/filter_menu.slint";
import { SearchHistoryMenu } from "dialogs/search_history_menu.slint";
import { TicketCard } from "components/ticket_card.slint";
import { KanbanColumn } from "components/kanban_column.slint";
import { DeleteConfirmDialog } from "dialogs/delete_confirm_dialog.slint";
import { StatsView } from "stats_view.slint";
import { SprintsView } from "sprints_view.slint";
import { AdminSettings } from "dialogs/admin_settings.slint";

export component App inherits Window {
    in-out property <[QueueStr]> board_queues;
    in-out property <string> search_query: "";
    in-out property <string> date_from: "";
    in-out property <string> date_to: "";
    in-out property <[string]> search_history: [];
    in-out property <bool> show_search_history: false;
    in-out property <bool> show_filter_menu: false;
    callback search-edited(string);
    callback accept-search(string);
    callback select-history-item(string);
    callback remove-search-item(string);
    callback date-filter-changed();
    callback focus-search();
    callback show-board-info();
    callback shortcut-open-new-ticket-dialog();
    callback toggle-queue-visibility(string, bool);
    callback move-ticket(string, string, string); // ticket_id, from_queue, index:...
    callback delete-ticket(string);
    callback update-ticket(string, string, string, string, int); // id, title, desc, assigned_to, points
    callback create-ticket(string, string, string, string, int); // queue_id, title, desc, assigned_to, points
    callback add-comment(string, string); // ticket_id, content
    callback set-queue-limit(string, int); // queue_id, limit
    callback open-warning-dialog(string); // message
    callback navigate-to(string); // for cross-references
    callback attach-file(string) -> string; // ticket_id
    callback open-attachment-folder(string); // ticket_id
    callback request-full-ticket(string) -> TicketStr;
    callback request-stats(); // loads data into board_stats and shows view
    callback request-sprints-view(); // opens sprints list view
    
    callback test-trigger-add-ticket(string); // for testing
    callback test-trigger-close-view(); // for testing
    callback test-trigger-cancel-edit(); // for testing
    callback test-trigger-delete-ticket(string); // for testing
    callback test-trigger-select-history(string); // for testing
    callback test-trigger-remove-history(string); // for testing
    callback test-trigger-move-ticket(string, string, string); // for testing
    callback test-get-first-ticket-id() -> string; // for testing
    callback test-trigger-edit-ticket(string, string, string, string, int); // for testing: id, title, desc, assigned, points
    // State
    in-out property <bool> show_ticket_view_dialog: false;
    in-out property <TicketStr> active_ticket;

    // Editing state
    in-out property <bool> show_ticket_edit_dialog: false;
    in-out property <TicketStr> editing_ticket;
    in-out property <string> new_ticket_queue_id: "";
    // Warning dialog state
    in-out property <bool> show_warning_dialog: false;
    out property <string> warning_message: "";

    // Limit editing state
    property <bool> show_queue_limit_dialog: false;
    property <string> queue_id_for_limit_edit: "";
    property <string> queue_name_for_limit_edit: "";
    property <string> queue_limit_text_for_edit: "";
    
    // Deletion state
    in-out property <bool> show_delete_confirm_dialog: false;
    in-out property <string> deleting_id: "";
    in-out property <string> deleting_title: "";

    // Stats View
    in-out property <bool> show_stats_view: false;
    in-out property <BoardSummaryStr> board_stats;

    // Sprint Info
    in-out property <bool> has_active_sprint: false;
    in-out property <SprintStr> active_sprint;
    in-out property <bool> show_sprints_view: false;
    in-out property <[SprintStr]> all_sprints;

    // Admin Mode
    in-out property <bool> is_admin: false;
    in-out property <bool> show_admin_settings: false;
    in-out property <string> board_readme_content: "";

    callback save-board-readme(string);
    callback admin-add-user(string);
    callback admin-remove-user(string);
    callback admin-add-queue(string);
    callback admin-rename-queue(string, string);
    callback admin-delete-queue(string);
    callback admin-add-sprint(string, string, string);
    callback admin-update-sprint(int, string, string, string);
    callback admin-remove-sprint(int);
    callback request-admin-data(); // Loads readme and other info

    preferred-width: 1024px;
    preferred-height: 768px;
    min-width: 400px;
    min-height: 300px;

    title: @tr("Slint Kanban");
    forward-focus: focus_scope;

    init => {
        focus_scope.focus();
    }

    config := AppConfig { }

    focus_scope := FocusScope {
        // Hotkey bindings
        KeyBinding {
            keys: @keys(Control + F);
            activated => {
                search-input.focus();
                focus-search();
            }
        }

        KeyBinding {
            keys: @keys(Control + N);
            activated => {
                shortcut-open-new-ticket-dialog();
            }
        }

        KeyBinding {
            keys: @keys(Control + M);
            activated => {
                UserGlobal.toggle-show-only-mine(!UserGlobal.show-only-mine);
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                show_warning_dialog = false;
                show_queue_limit_dialog = false;
                show_ticket_edit_dialog = false;
                show_ticket_view_dialog = false;
                show_search_history = false;
                show_filter_menu = false;
                show_delete_confirm_dialog = false;
                search_query = "";
                search-edited("");
            }
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

            // Search Header
            Rectangle {
                height: 60px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 20px;

                    // Left spacer for layout balance
                    Rectangle {
                        width: 40px;
                    }

                    HorizontalBox {
                        spacing: 12px;
                        alignment: center;

                        Text {
                            text: @tr("Search:");
                            vertical-alignment: center;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 400px;
                            search-input := LineEdit {
                                width: 100%;
                                text <=> search_query;
                                placeholder-text: @tr("Filter titles, descriptions or IDs...");
                                edited(text) => {
                                    search-edited(text);
                                }
                                accepted(text) => {
                                    accept-search(text);
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.DownArrow) {
                                        show_search_history = true;
                                        return accept;
                                    }
                                    if (event.text == Key.Escape) {
                                        search_query = "";
                                        search-edited("");
                                        focus_scope.focus();
                                        return accept;
                                    }
                                    reject
                                }
                            }

                            if (search_query != ""): Rectangle {
                                x: parent.width - self.width - 8px;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: clear-touch.pressed ? #ccc : clear-touch.has-hover ? #ddd : transparent;
                                Text {
                                    text: "✕";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    font-size: 12px;
                                }

                                clear-touch := TouchArea {
                                    clicked => {
                                        search_query = "";
                                        search-edited("");
                                    }
                                }
                            }
                        }

                        history-btn := Button {
                            text: @tr("History");
                            clicked => {
                                show_search_history = !show_search_history;
                            }
                        }

                        Button {
                            text: @tr("Board Info");
                            clicked => {
                                show-board-info();
                            }
                        }

                        if (has_active_sprint): Rectangle {
                            background: Palette.border;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text {
                                    text: @tr("🏃 Sprint {}: {}", active_sprint.number, active_sprint.name);
                                    vertical-alignment: center;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    request-sprints-view();
                                }
                            }
                        }
                    }

                    // Right aligned filter button
                    HorizontalLayout {
                        alignment: end;
                        padding-right: 15px;
                        spacing: 12px;
                        if (is_admin): Button {
                            text: @tr("🛠 Admin");
                            clicked => {
                                request-admin-data();
                                show_admin_settings = true;
                            }
                        }

                        settings-btn := Button {
                            text: "⚙"; // Gear icon for settings/filter
                            width: 40px;
                            clicked => {
                                show_filter_menu = !show_filter_menu;
                            }
                        }
                    }
                }
            }

            ScrollView {
                columns-row := HorizontalLayout {
                    padding: config.board-padding;
                    spacing: config.column-spacing;
                    alignment: start;

                    for queue in board_queues: KanbanColumn {
                        visible: queue.visible;
                        queue: queue;
                        width: self.visible ? config.column-width : 0px;

                        delete-ticket(ticket_to_delete) => {
                            deleting_id = ticket_to_delete.id;
                            deleting_title = ticket_to_delete.title;
                            show_delete_confirm_dialog = true;
                        }
                        edit-ticket(ticket_metadata) => {
                            active_ticket = request-full-ticket(ticket_metadata.id);
                            show_ticket_view_dialog = true;
                        }
                        open-new-ticket-dialog(queue_id) => {
                            root.test-trigger-add-ticket(queue_id);
                        }
                        open-limit-dialog(queue_id, queue_name, queue_limit) => {
                            queue_id_for_limit_edit = queue_id;
                            queue_name_for_limit_edit = queue_name;
                            queue_limit_text_for_edit = queue_limit > 0 ? queue_limit : "";
                            show_queue_limit_dialog = true;
                        }
                    }
                }
            }
        }
    }

    // Warning dialog handler
    open-warning-dialog(msg) => {
        warning_message = msg;
        show_warning_dialog = true;
    }

    test-trigger-add-ticket(qid) => {
        editing_ticket.id = "";
        editing_ticket.title = @tr("New Ticket");
        editing_ticket.description = "";
        editing_ticket.snippet = "";
        editing_ticket.created_at = "";
        editing_ticket.updated_at = "";
        editing_ticket.assigned_to = (UserGlobal.active-user == "<unassigned>") ? "" : UserGlobal.active-user;
        editing_ticket.author = (UserGlobal.active-user == "<unassigned>") ? "" : UserGlobal.active-user;
        editing_ticket.references = [];
        editing_ticket.comments = [];
        editing_ticket.attachment_count = 0;
        editing_ticket.points = 0;
        new_ticket_queue_id = qid;
        show_ticket_edit_dialog = true;
    }

    test-trigger-close-view() => {
        show_ticket_view_dialog = false;
    }

    test-trigger-cancel-edit() => {
        show_ticket_edit_dialog = false;
    }

    test-trigger-delete-ticket(tid) => {
        delete-ticket(tid);
    }

    test-trigger-select-history(q) => {
        search_query = q;
        select-history-item(q);
    }

    test-trigger-remove-history(q) => {
        remove-search-item(q);
    }

    test-trigger-move-ticket(tid, src, tgt) => {
        move-ticket(tid, src, tgt);
    }

    test-trigger-edit-ticket(id, title, desc, assigned, points) => {
        editing_ticket.id = id;
        editing_ticket.title = title;
        editing_ticket.description = desc;
        editing_ticket.snippet = "";
        editing_ticket.created_at = "";
        editing_ticket.updated_at = "";
        editing_ticket.assigned_to = assigned;
        editing_ticket.author = "";
        editing_ticket.references = [];
        editing_ticket.comments = [];
        editing_ticket.attachment_count = 0;
        editing_ticket.points = points;
        show_ticket_edit_dialog = true;
    }
    // Ticket View Overlay
    if (show_ticket_view_dialog): TicketView {
        ticket: active_ticket;
        close => {
            show_ticket_view_dialog = false;
        }
        edit => {
            show_ticket_view_dialog = false;
            editing_ticket = active_ticket;
            show_ticket_edit_dialog = true;
        }
        navigate-to(target) => {
            navigate-to(target);
        }
        add-comment(content) => {
            root.add-comment(active_ticket.id, content);
        }
        attach-file(id) => {
            root.attach-file(id)
        }
        open-attachment-folder(id) => {
            root.open-attachment-folder(id);
        }
        request-stats => {
            request-stats();
        }
    }

    // Edit Overlay
    if (show_ticket_edit_dialog): TicketEdit {
        ticket: editing_ticket;
        users: UserGlobal.users;

        cancel => {
            show_ticket_edit_dialog = false;
        }
        save(id, title, desc, assigned, pts) => {
            show_ticket_edit_dialog = false;
            if (id == "") {
                create-ticket(new_ticket_queue_id, title, desc, assigned, pts);
            } else {
                update-ticket(id, title, desc, assigned, pts);
            }
        }
        attach-file(id) => {
            root.attach-file(id)
        }
    }

    // Warning Dialog Overlay
    if (show_warning_dialog): WarningDialog {
        message: warning_message;
        close => {
            show_warning_dialog = false;
        }
    }

    // Limit Edit Overlay
    if (show_queue_limit_dialog): QueueLimitEdit {
        queue_id: queue_id_for_limit_edit;
        queue_name: queue_name_for_limit_edit;
        limit_text: queue_limit_text_for_edit;

        cancel => {
            show_queue_limit_dialog = false;
        }
        remove-limit(qid) => {
            show_queue_limit_dialog = false;
            set-queue-limit(qid, -1);
        }
        save(qid, limit) => {
            show_queue_limit_dialog = false;
            set-queue-limit(qid, limit);
        }
    }

    // Filter Menu Overlay
    if (show_filter_menu): FilterMenu {
        x: parent.width - self.width - 20px; // Top Right
        y: 70px; // Below header
        width: 250px;
        height: self.preferred-height;
        queues: board_queues;
        date_from <=> root.date_from;
        date_to <=> root.date_to;
        close => {
            show_filter_menu = false;
        }
        toggle-visibility(qid, visible) => {
            toggle-queue-visibility(qid, visible);
        }
        date-filter-changed => {
            root.date-filter-changed();
        }
    }

    // Delete Confirmation Overlay
    if (show_delete_confirm_dialog): DeleteConfirmDialog {
        ticket_id: deleting_id;
        ticket_title: deleting_title;
        cancel => {
            show_delete_confirm_dialog = false;
        }
        confirm => {
            show_delete_confirm_dialog = false;
            root.delete-ticket(deleting_id);
        }
    }

    // Search History Menu Overlay
    if (show_search_history): SearchHistoryMenu {
        x: (parent.width - self.width) / 2;
        y: 70px; // Below header
        width: 400px;
        history: search_history;
        select-history-item(query) => {
            show_search_history = false;
            search_query = query;
            select-history-item(query);
        }
        remove-history-item(query) => {
            remove-search-item(query);
        }
        close => {
            show_search_history = false;
        }
    }
    test-get-first-ticket-id() => {
        if (board_queues.length > 0 && board_queues[0].tickets.length > 0) {
            return board_queues[0].tickets[0].id;
        }
        if (board_queues.length > 1 && board_queues[1].tickets.length > 0) {
            return board_queues[1].tickets[0].id;
        }
        if (board_queues.length > 2 && board_queues[2].tickets.length > 0) {
            return board_queues[2].tickets[0].id;
        }
        if (board_queues.length > 3 && board_queues[3].tickets.length > 0) {
            return board_queues[3].tickets[0].id;
        }
        return "";
    }

    if (show_stats_view): StatsView {
        stats: board_stats;
        close => {
            show_stats_view = false;
        }
    }

    if (show_sprints_view): SprintsView {
        sprints: all_sprints;
        close => {
            show_sprints_view = false;
        }
    }

    if (show_admin_settings): AdminSettings {
        users: UserGlobal.users;
        queues: board_queues;
        sprints: all_sprints;
        board_readme <=> board_readme_content;
        close => {
            show_admin_settings = false;
        }
        save_readme(content) => {
            save-board-readme(content);
        }
        add_user(name) => {
            admin-add-user(name);
        }
        remove_user(name) => {
            admin-remove-user(name);
        }
        add_queue(name) => {
            admin-add-queue(name);
        }
        rename_queue(id, name) => {
            admin-rename-queue(id, name);
        }
        delete_queue(id) => {
            admin-delete-queue(id);
        }
        add_sprint(name, start, end) => {
            admin-add-sprint(name, start, end);
        }
        update_sprint(number, name, start, end) => {
            admin-update-sprint(number, name, start, end);
        }
        remove_sprint(number) => {
            admin-remove-sprint(number);
        }
    }
}
