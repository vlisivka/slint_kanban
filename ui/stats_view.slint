import {
    Button,
    ScrollView,
    Palette,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { BoardSummaryStr } from "common.slint";

export component StatsView inherits Rectangle {
    in property <BoardSummaryStr> stats;
    callback close();

    background: Palette.background;
    width: 100%;
    height: 100%;

    VerticalBox {
        padding: 40px;
        spacing: 20px;

        HorizontalLayout {
            Text {
                text: @tr("Board Statistics");
                overflow: elide;
                font-size: 24px;
                font-weight: 700;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: @tr("Back to Board");
                clicked => {
                    close();
                }
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 20px;

                // Summary
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("== Board Summary ==");
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("Total tickets: {}", stats.total_tickets);
                        overflow: elide;
                    }

                    Text {
                        text: @tr("Unassigned: {}", stats.unassigned_tickets);
                        overflow: elide;
                    }

                    Text {
                        text: @tr("Average Lead Time: {}", stats.avg_lead_time);
                        overflow: elide;
                    }

                    Text {
                        text: @tr("Average Cycle Time: {}", stats.avg_cycle_time);
                        overflow: elide;
                    }

                    if stats.completion_rate != "": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Ticket Completion Rate: {}", stats.completion_rate);
                            overflow: elide;
                        }

                        Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_completion_rate / 100.0);
                                height: 100%;
                                background: #4CAF50;
                                border-radius: 6px;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Points: {} / {}", stats.total_done_points, stats.total_points);
                            overflow: elide;
                        }

                        if stats.total_points > 0: Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_points_completion_rate / 100.0);
                                height: 100%;
                                background: #2196F3;
                                border-radius: 6px;
                            }
                        }
                    }

                    if stats.points_completion_rate != "": Text {
                        text: @tr("Points Completion Rate: {}", stats.points_completion_rate);
                        color: #2196F3;
                        overflow: elide;
                    }
                    if stats.sprint_completion_rate != "" && stats.sprint_completion_rate != "-": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Sprint Completion Rate (Tickets): {}", stats.sprint_completion_rate);
                            color: #FF9800;
                            overflow: elide;
                        }

                        Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_sprint_completion_rate / 100.0);
                                height: 100%;
                                background: #FF9800;
                                border-radius: 6px;
                            }
                        }
                    }
                }

                // Trends
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("== Trends (Total vs Done Points) ==");
                        font-weight: 700;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 200px;
                        background: Palette.alternate-background;
                        border-radius: 4px;
                        property <length> chart-h: 160px;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 4px;
                            alignment: space-around;

                            for tp in stats.trend: VerticalLayout {
                                alignment: end;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                // Tooltip-like value
                                if tp.total_points > 0: Text {
                                    text: tp.done_points + "/" + tp.total_points;
                                    font-size: 7px;
                                    horizontal-alignment: center;
                                    opacity: 0.5;
                                }

                                // Bar container
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: (stats.total_points > 0) ? Math.max(chart-h * (tp.total_points / (stats.total_points * 1.0)), 4px) : 2px;
                                    background: #2196F340;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    clip: true;

                                    // Done Points Bar
                                    Rectangle {
                                        y: parent.height - self.height;
                                        width: 100%;
                                        height: (tp.total_points > 0) ? parent.height * (tp.done_points / (tp.total_points * 1.0)) : 0px;
                                        background: #4CAF50;
                                        border-radius: 1px;
                                    }
                                }
                                
                                // Mini label for date
                                Text {
                                    text: tp.timestamp;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Legend for the chart
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                background: #2196F340;
                                border-radius: 2px;
                            }

                            Text {
                                text: @tr("Total Points (Scope)");
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                background: #4CAF50;
                                border-radius: 2px;
                            }

                            Text {
                                text: @tr("Done Points (Completed)");
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Text {
                        text: @tr("Early stages show only Total Points as work needs time to be completed.");
                        font-size: 10px;
                        opacity: 0.6;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                // Burndown Chart
                if stats.burndown.length > 0: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("== Sprint Burndown Chart ==");
                        font-weight: 700;
                        overflow: elide;
                    }

                    stats-burndown-rect := Rectangle {
                        height: 200px;
                        background: Palette.alternate-background;
                        border-radius: 4px;
                        property <length> chart-h: 160px;
                        property <int> effective-max: (stats.max_burndown_points > 0) ? stats.max_burndown_points : 1;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 4px;
                            alignment: space-around;

                            for bp in stats.burndown: VerticalLayout {
                                alignment: end;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                // Tooltip-like value
                                Text {
                                    text: bp.remaining_points + "/" + bp.ideal_points;
                                    font-size: 7px;
                                    horizontal-alignment: center;
                                    opacity: 0.5;
                                }

                                // Bar container
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: chart-h;
                                    background: transparent;
                                    
                                    // Actual Remaining Points Bar (rendered FIRST, so it's behind)
                                    if bp.remaining_points > 0: Rectangle {
                                        x: parent.width / 2 - 4px;
                                        y: parent.height - self.height;
                                        width: 8px;
                                        height: Math.max(chart-h * (bp.remaining_points / (effective-max * 1.0)), 2px);
                                        background: #2196F3;
                                        border-radius: 2px;
                                    }

                                    // Ideal Line representation (thin bar, rendered LAST, so it's in front)
                                    Rectangle {
                                        x: parent.width / 2 - 1px;
                                        y: parent.height - self.height;
                                        width: 2px;
                                        height: Math.max(chart-h * (bp.ideal_points / (effective-max * 1.0)), 1px);
                                        background: #f44336; // Red for ideal
                                        opacity: 1.0;
                                    }
                                }
                                
                                // Mini label for date
                                Text {
                                    text: bp.date;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Legend
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                background: #2196F3;
                                border-radius: 2px;
                            }

                            Text {
                                text: @tr("Remaining Points");
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 14px;
                                height: 2px;
                                background: #f44336;
                                opacity: 0.5;
                            }

                            Text {
                                text: @tr("Ideal Burndown");
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Queues
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("== Tickets per Queue ==");
                        font-weight: 700;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: @tr("Queue");
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: @tr("Count");
                            font-weight: 700;
                            horizontal-alignment: right;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: @tr("Limit");
                            font-weight: 700;
                            horizontal-alignment: right;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: @tr("Usage");
                            font-weight: 700;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }

                    for q in stats.queues: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: q.name;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: q.count;
                            horizontal-alignment: right;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: q.limit;
                            horizontal-alignment: right;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: q.usage;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }

                // Users
                VerticalLayout {
                    Text {
                        text: @tr("== Tickets per User ==");
                        font-weight: 700;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: @tr("User");
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: @tr("Count");
                            font-weight: 700;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }

                    for u in stats.users: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: u.name;
                            overflow: elide;
                        }

                        Text {
                            width: 60px;
                            text: u.count;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
