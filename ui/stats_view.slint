import {
    Button,
    ScrollView,
    Palette,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { BoardSummaryStr } from "common.slint";

export component StatsView inherits Rectangle {
    in property <BoardSummaryStr> stats;
    callback close();

    background: Palette.background;
    width: 100%;
    height: 100%;

    VerticalBox {
        padding: 40px;
        spacing: 20px;

        HorizontalLayout {
            Text {
                text: "Board Statistics";
                font-size: 24px;
                font-weight: 700;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Back to Board";
                clicked => {
                    close();
                }
            }
        }

        ScrollView {
            VerticalLayout {
                spacing: 20px;

                // Summary
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "== Board Summary ==";
                        font-weight: 700;
                    }

                    Text {
                        text: "Total tickets: " + stats.total_tickets;
                    }

                    Text {
                        text: "Unassigned: " + stats.unassigned_tickets;
                    }

                    Text {
                        text: "Average Lead Time: " + stats.avg_lead_time;
                    }

                    Text {
                        text: "Average Cycle Time: " + stats.avg_cycle_time;
                    }

                    if stats.completion_rate != "": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Ticket Completion Rate: " + stats.completion_rate;
                        }

                        Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_completion_rate / 100.0);
                                height: 100%;
                                background: #4CAF50;
                                border-radius: 6px;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Points: " + stats.total_done_points + " / " + stats.total_points;
                        }

                        if stats.total_points > 0: Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_points_completion_rate / 100.0);
                                height: 100%;
                                background: #2196F3;
                                border-radius: 6px;
                            }
                        }
                    }

                    if stats.points_completion_rate != "": Text {
                        text: "Points Completion Rate: " + stats.points_completion_rate;
                        color: #2196F3;
                        font-weight: 700;
                    }

                    if stats.sprint_completion_rate != "" && stats.sprint_completion_rate != "-": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Sprint Completion Rate (Tickets): " + stats.sprint_completion_rate;
                            color: #FF9800;
                        }

                        Rectangle {
                            height: 12px;
                            background: Palette.alternate-background;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: parent.width * (stats.f_sprint_completion_rate / 100.0);
                                height: 100%;
                                background: #FF9800;
                                border-radius: 6px;
                            }
                        }
                    }
                }

                // Trends
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "== Trends (Total vs Done Points) ==";
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 200px;
                        background: Palette.alternate-background;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 4px;

                            for tp in stats.trend: VerticalLayout {
                                alignment: end;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                // Total Points Bar
                                Rectangle {
                                    width: 100%;
                                    height: (stats.total_points > 0) ? (parent.height - 20px) * (tp.total_points / (stats.total_points * 1.0)) : 2px;
                                    background: #2196F340;
                                    border-radius: 2px;

                                    // Done Points Bar (inner)
                                    Rectangle {
                                        y: parent.height - self.height;
                                        width: 100%;
                                        height: (tp.total_points > 0) ? parent.height * (tp.done_points / (tp.total_points * 1.0)) : 0px;
                                        background: #2196F3;
                                        border-radius: 2px;
                                    }
                                }
                                
                                // Mini label for date
                                Text {
                                    text: tp.timestamp;
                                    font-size: 8px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Queues
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "== Tickets per Queue ==";
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: "Queue";
                            font-weight: 700;
                        }

                        Text {
                            width: 60px;
                            text: "Count";
                            font-weight: 700;
                            horizontal-alignment: right;
                        }

                        Text {
                            width: 60px;
                            text: "Limit";
                            font-weight: 700;
                            horizontal-alignment: right;
                        }

                        Text {
                            width: 60px;
                            text: "Usage";
                            font-weight: 700;
                            horizontal-alignment: right;
                        }
                    }

                    for q in stats.queues: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: q.name;
                        }

                        Text {
                            width: 60px;
                            text: q.count;
                            horizontal-alignment: right;
                        }

                        Text {
                            width: 60px;
                            text: q.limit;
                            horizontal-alignment: right;
                        }

                        Text {
                            width: 60px;
                            text: q.usage;
                            horizontal-alignment: right;
                        }
                    }
                }

                // Users
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "== Tickets per User ==";
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: "User";
                            font-weight: 700;
                        }

                        Text {
                            width: 60px;
                            text: "Count";
                            font-weight: 700;
                            horizontal-alignment: right;
                        }
                    }

                    for u in stats.users: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            width: 200px;
                            text: u.name;
                        }

                        Text {
                            width: 60px;
                            text: u.count;
                            horizontal-alignment: right;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
