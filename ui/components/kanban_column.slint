import {
    ScrollView,
    Palette,
} from "std-widgets.slint";
import { QueueStr, TicketStr, Theme, Api } from "../common.slint";
import { TicketCard } from "./ticket_card.slint";

export component KanbanColumn inherits Rectangle {
    in property <QueueStr> queue;

    // Drag/Drop/Delete/Edit callbacks
    callback delete-ticket(TicketStr);
    callback edit-ticket(TicketStr);
    callback open-new-ticket-dialog(string); // queue_id
    callback open-limit-dialog(string, string, int); // id, name, current_limit
    width: 280px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: Palette.alternate-background;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            padding: 0px;
            alignment: space-between;

            VerticalLayout {
                Text {
                    text: queue.name;
                    font-weight: 800;
                    font-size: 16px;
                }

                if queue.total_points > 0: Text {
                    text: @tr("{} pts total", queue.total_points);
                    font-size: 11px;
                    opacity: 0.7;
                    color: Theme.success;
                }
            }

            // Limit badge and action buttons
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // New Ticket button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;

                    Text {
                        text: "+";
                        font-size: 20px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    touch-add := TouchArea {
                        clicked => {
                            open-new-ticket-dialog(queue.id);
                        }
                    }
                }

                // Limit Badge (clickable)
                if queue.limit > 0: TouchArea {
                    clicked => {
                        open-limit-dialog(queue.id, queue.name, queue.limit);
                    }

                    Rectangle {
                        height: 24px;
                        min-width: 50px;
                        border-radius: 12px;
                        background: {
                            if queue.ticket_count >= queue.limit {
                                Theme.danger
                            } else if queue.ticket_count >= queue.limit * 80 / 100 {
                                Theme.warning
                            } else {
                                Theme.success
                            }
                        };

                        Text {
                            text: @tr("{}/{}", queue.ticket_count, queue.limit);
                            font-size: 12px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Gear icon to set a limit when none exists
                if queue.limit <= 0: Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    opacity: touch-limit-none.has-hover ? 1.0 : 0.3;

                    Text {
                        text: "⚙";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    touch-limit-none := TouchArea {
                        clicked => {
                            open-limit-dialog(queue.id, queue.name, -1);
                        }
                    }
                }
            }
        }

        drop-area := DropArea {
            vertical-stretch: 1;

            can-drop(event) => {
                return Api.can-drop(event);
            }
            dropped(event) => {
                Api.dropped(event, root.queue.id);
                return event.proposed-action;
            }

            Rectangle {
                background: drop-area.has-drag ? #0d1117 : transparent;
                animate background { duration: 150ms; }
                ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        for ticket in queue.tickets: TicketCard {
                            ticket: ticket;
                            from_queue_id: queue.id;
                            delete-ticket(ticket_to_delete) => {
                                delete-ticket(ticket_to_delete);
                            }
                            edit-ticket(ticket_to_edit) => {
                                edit-ticket(ticket_to_edit);
                            }
                        }
                    }
                }
            }
        }
    }
}
