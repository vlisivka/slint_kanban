import { Palette } from "std-widgets.slint";
import { TicketStr, IdCopy, CloseButton, Theme } from "../common.slint";

export component TicketCard inherits Rectangle {
    in property <TicketStr> ticket;
    in property <string> from_queue_id;

    // Callbacks
    callback start-dragging(string, string, length, length);
    callback move-dragging(length, length);
    callback drop-ticket(length);
    callback delete-ticket(TicketStr);
    callback edit-ticket(TicketStr);

    border-radius: 8px;
    border-width: 1px;
    border-color: touch-area.has-hover ? Palette.border : Palette.border.transparentize(70%);
    height: 140px;
    
    // Performance optimization: only render shadows on hover.
    // Drop shadows are expensive to render during scrolling.
    drop-shadow-blur: touch-area.has-hover ? 6px : 0px;
    drop-shadow-offset-y: touch-area.has-hover ? 3px : 0px;
    drop-shadow-color: touch-area.has-hover ? #00000040 : transparent;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: 150ms; }

    touch-area := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                start-dragging(ticket.id, from_queue_id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (event.kind == PointerEventKind.up) {
                drop-ticket(self.absolute-position.x + self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                move-dragging(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            edit-ticket(ticket);
        }
    }

    property <color> point-color: ticket.points == 1 ? Theme.point-1 : ticket.points == 2 ? Theme.point-2 : ticket.points == 3 ? Theme.point-3 : ticket.points == 4 ? Theme.point-4 : ticket.points == 5 ? Theme.point-5 : ticket.points == 6 ? Theme.point-6 : ticket.points == 7 ? Theme.point-7 : ticket.points == 8 ? Theme.point-8 : ticket.points == 9 ? Theme.point-9 : ticket.points == 10 ? Theme.point-10 : Theme.point-0;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: ticket.title;
                font-weight: 700;
                font-size: 15px;
                overflow: elide;
                horizontal-stretch: 1;
            }

            CloseButton {
                clicked => {
                    delete-ticket(ticket);
                }
            }
        }

        Text {
            text: ticket.snippet;
            font-size: 13px;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                IdCopy {
                    id: ticket.id;
                    font-size: 11px;
                }

                if ticket.author != "": Text {
                    text: "✍ " + ticket.author;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.author-color;
                }

                if ticket.assigned_to != "": Text {
                    text: "👤 " + ticket.assigned_to;
                    font-size: 11px;
                    font-weight: 500;
                    color: Palette.accent-background;
                }

                if ticket.points > 0: Rectangle {
                    height: 18px;
                    width: pts_txt.preferred-width + 12px;
                    background: root.point-color;
                    border-radius: 9px;
                    pts_txt := Text {
                        text: "⭐ " + ticket.points;
                        font-size: 10px;
                        font-weight: 800;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: end;
                Text {
                    text: "C: " + ticket.created_at;
                    font-size: 9px;
                    opacity: 0.6;
                }

                Text {
                    text: "U: " + ticket.updated_at;
                    font-size: 9px;
                    opacity: 0.6;
                }
            }
        }
    }
}
