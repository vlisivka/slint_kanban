import { Palette } from "std-widgets.slint";
import {
    TicketStr,
    IdCopy,
    CloseButton,
    Theme,
    UserGlobal,
    Api,
} from "../common.slint";

export component TicketCard inherits Rectangle {
    in property <TicketStr> ticket;
    in property <string> from_queue_id;

    // Callbacks
    callback delete-ticket(TicketStr);
    callback edit-ticket(TicketStr);

    border-radius: 8px;
    border-width: 1px;
    border-color: touch-area.has-hover ? Palette.border : Palette.border.transparentize(70%);
    height: 140px;
    
    // Performance optimization: only render shadows on hover.
    // Drop shadows are expensive to render during scrolling.
    drop-shadow-blur: touch-area.has-hover ? 6px : 0px;
    drop-shadow-offset-y: touch-area.has-hover ? 3px : 0px;
    drop-shadow-color: touch-area.has-hover ? #00000040 : transparent;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: 150ms; }

    property <bool> can-manage: !UserGlobal.manage-only-mine || UserGlobal.active-user == ticket.assigned_to || UserGlobal.active-user == ticket.author || UserGlobal.active-user == "admin" || UserGlobal.active-user == "<unassigned>";

    drag-area := DragArea {
        data: Api.make-transfer(ticket.id, from_queue_id);
        allow-copy: root.can-manage;
        allow-move: root.can-manage;
        opacity: self.dragging ? 0.4 : 1.0;
        animate opacity { duration: 150ms; }

        touch-area := TouchArea {
            clicked => {
                edit-ticket(ticket);
            }
        }
    }

    property <color> point-color: ticket.points == 1 ? Theme.point-1 : ticket.points == 2 ? Theme.point-2 : ticket.points == 3 ? Theme.point-3 : ticket.points == 4 ? Theme.point-4 : ticket.points == 5 ? Theme.point-5 : ticket.points == 6 ? Theme.point-6 : ticket.points == 7 ? Theme.point-7 : ticket.points == 8 ? Theme.point-8 : ticket.points == 9 ? Theme.point-9 : ticket.points == 10 ? Theme.point-10 : Theme.point-0;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: ticket.title;
                font-weight: 700;
                font-size: 15px;
                overflow: elide;
                horizontal-stretch: 1;
            }

            CloseButton {
                visible: root.can-manage;
                clicked => {
                    delete-ticket(ticket);
                }
            }
        }

        Text {
            text: ticket.snippet;
            font-size: 13px;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                IdCopy {
                    id: ticket.id;
                    font-size: 11px;
                }

                if ticket.author != "": Text {
                    text: @tr("✍ {}", ticket.author);
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.author-color;
                }

                if ticket.assigned_to != "": Text {
                    text: @tr("👤 {}", ticket.assigned_to);
                    font-size: 11px;
                    font-weight: 500;
                    color: Palette.accent-background;
                }

                if ticket.points > 0: Rectangle {
                    height: 18px;
                    width: pts_txt.preferred-width + 12px;
                    background: root.point-color;
                    border-radius: 9px;
                    pts_txt := Text {
                        text: @tr("⭐ {}", ticket.points);
                        font-size: 10px;
                        font-weight: 800;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: end;
                Text {
                    text: @tr("C: {}", ticket.created_at);
                    font-size: 9px;
                    opacity: 0.6;
                }

                Text {
                    text: @tr("U: {}", ticket.updated_at);
                    font-size: 9px;
                    opacity: 0.6;
                }
            }
        }
    }
}
