import {
    Button,
    CheckBox,
    LineEdit,
    Palette,
    ComboBox,
} from "std-widgets.slint";
import { QueueStr, UserGlobal } from "../common.slint";

export component FilterMenu inherits Rectangle {
    in-out property <[QueueStr]> queues;
    in-out property <string> date_from;
    in-out property <string> date_to;
    callback toggle-visibility(string, bool);
    callback date-filter-changed();
    callback close();

    background: Palette.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    drop-shadow-blur: 15px;
    drop-shadow-color: #00000040;

    height: self.preferred-height;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "User Settings";
            font-size: 16px;
            font-weight: 700;
        }

        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Active User:";
                font-size: 14px;
                opacity: 0.7;
            }

            user-config-combo := ComboBox {
                model: UserGlobal.users;
                current-value: UserGlobal.active-user;
                selected(val) => {
                    UserGlobal.change-active-user(val);
                }
            }
        }

        check-my-tickets := CheckBox {
            text: "Show only my tickets";
            checked <=> UserGlobal.show-only-mine;
            toggled => {
                UserGlobal.toggle-show-only-mine(self.checked);
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Visible Queues";
                font-size: 16px;
                font-weight: 700;
            }
        }

        VerticalLayout {
            spacing: 10px;
            for q in queues: HorizontalLayout {
                spacing: 10px;
                CheckBox {
                    text: q.name;
                    checked: q.visible;
                    toggled => {
                        toggle-visibility(q.id, self.checked);
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        Text {
            text: "Filter by Date Range";
            font-size: 14px;
            font-weight: 700;
        }

        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "From:";
                    vertical-alignment: center;
                    width: 40px;
                }

                date-from-input := LineEdit {
                    text <=> date_from;
                    placeholder-text: "YYYY-MM-DD";
                    edited => {
                        date-filter-changed();
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "To:";
                    vertical-alignment: center;
                    width: 40px;
                }

                date-to-input := LineEdit {
                    text <=> date_to;
                    placeholder-text: "YYYY-MM-DD";
                    edited => {
                        date-filter-changed();
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => {
                    close();
                }
            }
        }
    }
}
