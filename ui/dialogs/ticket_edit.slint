import {
    Button,
    LineEdit,
    TextEdit,
    VerticalBox,
    HorizontalBox,
    Palette,
} from "std-widgets.slint";

export component TicketEdit inherits Rectangle {
    in-out property <string> title_text;
    in-out property <string> description_text;
    in property <string> ticket_id;

    callback save(string, string, string); // id, title, desc
    callback cancel();

    background: #00000080; // Semi-transparent backdrop for focus

    // BACKDROP: Catch clicks outside the card to cancel
    TouchArea {
        clicked => {
            cancel();
        }
    }

    Rectangle {
        // Full window (fill parent)
        width: 100%;
        height: 100%;
        background: Palette.background;

        TouchArea { } // Block clicks

        VerticalBox {
            padding: 40px;
            spacing: 24px;

            HorizontalLayout {
                padding: 0px;
                alignment: space-between;

                Button {
                    text: "Cancel";
                    width: 100px;
                    height: 40px;
                    clicked => {
                        cancel();
                    }
                }

                // Title as header (centered)
                Text {
                    text: ticket_id == "" ? "Create New Ticket" : "Edit Ticket #" + ticket_id;
                    font-size: 32px;
                    font-weight: 800;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Button {
                    text: "Save Ticket";
                    primary: true;
                    width: 120px;
                    height: 40px;
                    clicked => {
                        save(ticket_id, title_text, description_text);
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Title";
                    font-size: 11px;
                    font-weight: 800;
                    opacity: 0.6;
                }

                LineEdit {
                    text <=> title_text;
                    placeholder-text: "What needs to be done?";
                    height: 40px;
                }
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Description";
                    font-size: 11px;
                    font-weight: 800;
                    opacity: 0.6;
                }

                TextEdit {
                    text <=> description_text;
                    placeholder-text: "What needs to be done?";
                    preferred-height: 400px;
                    vertical-stretch: 1;
                }
            }
        }
    }
}
