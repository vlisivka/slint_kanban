import {
    Button,
    LineEdit,
    TextEdit,
    ComboBox,
    VerticalBox,
    HorizontalBox,
    Palette,
} from "std-widgets.slint";
import { IdCopy, CloseButton, ModalBackdrop, Theme } from "../common.slint";

export component TicketEdit inherits Rectangle {
    in-out property <string> title_text;
    in-out property <string> description_text;
    in-out property <string> assigned_to;
    in property <[string]> users;
    in property <string> ticket_id;
    in property <string> author;

    callback save(string, string, string, string); // id, title, desc, assigned_to
    callback cancel();
    callback attach-file(string) -> string;

    ModalBackdrop {
        dismiss => {
            cancel();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.background;

            TouchArea { }

            VerticalBox {
                padding: 40px;
                spacing: 24px;

                HorizontalLayout {
                    padding: 0px;
                    alignment: space-between;

                    cancel-btn := Button {
                        text: "Cancel";
                        width: 100px;
                        height: 40px;
                        clicked => {
                            cancel();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: ticket_id == "" ? "Create New Ticket" : "Edit Ticket ";
                            font-size: 32px;
                            font-weight: 800;
                        }

                        if ticket_id != "": IdCopy {
                            id: ticket_id;
                            font-size: 32px;
                            height: 48px; // Match line height of the text roughly
                    }
                    }

                    save-btn := Button {
                        text: "Save Ticket";
                        primary: true;
                        width: 120px;
                        height: 40px;
                        clicked => {
                            save(ticket_id, title_text, description_text, assigned_to);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    if author != "": VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Author";
                            font-size: 11px;
                            font-weight: 800;
                            opacity: 0.6;
                        }

                        Text {
                            text: author;
                            font-size: 14px;
                            height: 40px;
                            vertical-alignment: center;
                            color: Theme.author-color;
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Assigned To";
                            font-size: 11px;
                            font-weight: 800;
                            opacity: 0.6;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            assign-combo := ComboBox {
                                model: users;
                                current-value: assigned_to == "" ? "<unassigned>" : assigned_to;
                                height: 40px;
                                width: 200px;
                                selected(val) => {
                                    assigned_to = (val == "<unassigned>") ? "" : val;
                                }
                            }

                            if assigned_to != "": CloseButton {
                                size: 32px;
                                clicked => {
                                    assigned_to = "";
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Title";
                        font-size: 11px;
                        font-weight: 800;
                        opacity: 0.6;
                    }

                    title-input := LineEdit {
                        text <=> title_text;
                        placeholder-text: "What needs to be done?";
                        height: 40px;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Description";
                        font-size: 11px;
                        font-weight: 800;
                        opacity: 0.6;
                    }

                    desc-input := TextEdit {
                        text <=> description_text;
                        placeholder-text: "What needs to be done?";
                        preferred-height: 400px;
                        vertical-stretch: 1;
                    }

                    if ticket_id != "": HorizontalLayout {
                        alignment: end;
                        attach-btn := Button {
                            text: "Attach File";
                            clicked => {
                                let link = root.attach-file(ticket_id);
                                if link != "" {
                                    if description_text != "" {
                                        description_text += "\n\n" + link;
                                    } else {
                                        description_text = link;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
