import {
    Button,
    VerticalBox,
    Palette,
} from "std-widgets.slint";

export component WarningDialog inherits Rectangle {
    in property <string> message;
    callback close();

    background: #00000080; // Semi-transparent backdrop

    // BACKDROP: Catch clicks outside to close
    TouchArea {
        clicked => {
            close();
        }
    }

    Rectangle {
        width: 400px;
        height: 200px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.background;
        border-radius: 12px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;

        TouchArea { } // Block clicks

        VerticalBox {
            padding: 24px;
            spacing: 20px;

            // Warning Icon and Title
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: #ff9800;

                    Text {
                        text: "⚠";
                        font-size: 32px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Warning";
                    font-size: 20px;
                    font-weight: 700;
                }
            }

            // Message
            Text {
                text: message;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            // Close Button
            Button {
                text: "OK";
                primary: true;
                clicked => {
                    close();
                }
            }
        }
    }
}
