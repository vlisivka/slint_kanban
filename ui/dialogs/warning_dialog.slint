import {
    Button,
    VerticalBox,
    Palette,
} from "std-widgets.slint";
import { ModalBackdrop, Theme } from "../common.slint";

export component WarningDialog inherits Rectangle {
    in property <string> message;
    callback close();

    ModalBackdrop {
        dismiss => {
            close();
        }

        Rectangle {
            width: 400px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            TouchArea { }

            VerticalBox {
                padding: 24px;
                spacing: 20px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        background: Theme.warning;

                        Text {
                            text: "⚠";
                            font-size: 32px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: @tr("Warning");
                        font-size: 20px;
                        font-weight: 700;
                    }
                }

                Text {
                    text: message;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                ok-btn := Button {
                    text: @tr("OK");
                    primary: true;
                    clicked => {
                        close();
                    }
                }
            }
        }
    }
}
