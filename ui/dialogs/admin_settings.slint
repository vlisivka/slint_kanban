import {
    Button,
    LineEdit,
    TextEdit,
    VerticalBox,
    HorizontalBox,
    Palette,
    ScrollView,
} from "std-widgets.slint";
import {
    CloseButton,
    ModalBackdrop,
    Theme,
    QueueStr,
    SprintStr,
} from "../common.slint";

export component AdminSettings inherits Rectangle {
    in property <[string]> users;
    in property <[QueueStr]> queues;
    in property <[SprintStr]> sprints;
    in-out property <string> board_readme;
    callback close();
    callback save_readme(string);
    callback add_user(string);
    callback remove_user(string);
    callback add_queue(string);
    callback rename_queue(string, string);
    callback delete_queue(string);
    callback add_sprint(string, string, string);
    callback update_sprint(int, string, string, string);
    callback remove_sprint(int);

    property <string> new_user_name: "";
    property <string> new_queue_name: "";
    property <string> new_sprint_name: "";
    property <string> new_sprint_start: "";
    property <string> new_sprint_end: "";
    property <int> active_tab: 0;

    ModalBackdrop {
        dismiss => {
            close();
        }

        Rectangle {
            width: 90%;
            height: 90%;
            background: Palette.background;
            border-radius: 8px;

            TouchArea { } // Block clicks from reaching backdrop

            VerticalBox {
                padding: 32px;
                spacing: 24px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("Administrator Settings");
                        font-size: 28px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Button {
                        text: @tr("Close");
                        width: 80px;
                        clicked => {
                            close();
                        }
                    }
                }

                // Tabs
                HorizontalLayout {
                    spacing: 8px;
                    height: 40px;
                    Button {
                        text: @tr("Documentation");
                        primary: active_tab == 0;
                        clicked => {
                            active_tab = 0;
                        }
                    }

                    Button {
                        text: @tr("Users");
                        primary: active_tab == 1;
                        clicked => {
                            active_tab = 1;
                        }
                    }

                    Button {
                        text: @tr("Queues");
                        primary: active_tab == 2;
                        clicked => {
                            active_tab = 2;
                        }
                    }

                    Button {
                        text: @tr("Sprints");
                        primary: active_tab == 3;
                        clicked => {
                            active_tab = 3;
                        }
                    }
                }

                // Tab Content
                if active_tab == 0: VerticalBox {
                    spacing: 12px;
                    Text {
                        text: @tr("Edit Board Overview (README.md)");
                        font-weight: 700;
                        opacity: 0.7;
                        overflow: elide;
                    }

                    readme_editor := TextEdit {
                        text <=> board_readme;
                        preferred-height: 400px;
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: @tr("Save Documentation");
                            primary: true;
                            clicked => {
                                save_readme(board_readme);
                            }
                        }
                    }
                }

                if active_tab == 1: VerticalBox {
                    spacing: 16px;
                    Text {
                        text: @tr("Manage Shared Users");
                        font-weight: 700;
                        opacity: 0.7;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        LineEdit {
                            text <=> new_user_name;
                            placeholder-text: @tr("Enter new username...");
                            accepted => {
                                if (new_user_name != "") {
                                    add_user(new_user_name);
                                    new_user_name = "";
                                }
                            }
                        }

                        Button {
                            text: @tr("Add User");
                            enabled: new_user_name != "";
                            clicked => {
                                add_user(new_user_name);
                                new_user_name = "";
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            for user in users: Rectangle {
                                height: 50px;
                                background: Palette.alternate-background;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;
                                    Text {
                                        text: user;
                                        vertical-alignment: center;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    if user != "<unassigned>" && user != "admin": CloseButton {
                                        size: 24px;
                                        clicked => {
                                            remove_user(user);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if active_tab == 2: VerticalBox {
                    spacing: 16px;
                    Text {
                        text: @tr("Manage Board Queues");
                        overflow: elide;
                        font-weight: 700;
                        opacity: 0.7;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        LineEdit {
                            text <=> new_queue_name;
                            placeholder-text: @tr("Enter new queue name (e.g., 8. Optional)...");
                            accepted => {
                                if (new_queue_name != "") {
                                    add_queue(new_queue_name);
                                    new_queue_name = "";
                                }
                            }
                        }

                        Button {
                            text: @tr("Add Queue");
                            enabled: new_queue_name != "";
                            clicked => {
                                add_queue(new_queue_name);
                                new_queue_name = "";
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            for q in queues: Rectangle {
                                height: 60px;
                                background: Palette.alternate-background;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    q_name_input := LineEdit {
                                        text: q.name;
                                        accepted(val) => {
                                            if (val != q.name) {
                                                rename_queue(q.id, val);
                                            }
                                        }
                                    }

                                    Text {
                                        text: @tr("({} tickets)", q.ticket_count);
                                        overflow: elide;
                                        vertical-alignment: center;
                                        opacity: 0.6;
                                        font-size: 12px;
                                    }

                                    if q.ticket_count == 0: CloseButton {
                                        size: 24px;
                                        clicked => {
                                            delete_queue(q.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if active_tab == 3: VerticalBox {
                    spacing: 16px;
                    Text {
                        text: @tr("Manage Sprints");
                        overflow: elide;
                        font-weight: 700;
                        opacity: 0.7;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        LineEdit {
                            text <=> new_sprint_name;
                            placeholder-text: @tr("Sprint Name");
                            horizontal-stretch: 1;
                        }

                        LineEdit {
                            text <=> new_sprint_start;
                            placeholder-text: @tr("Start (YYYY-MM-DD)");
                            width: 150px;
                        }

                        LineEdit {
                            text <=> new_sprint_end;
                            placeholder-text: @tr("End (YYYY-MM-DD)");
                            width: 150px;
                        }

                        Button {
                            text: @tr("Add Sprint");
                            enabled: new_sprint_name != "" && new_sprint_start != "" && new_sprint_end != "";
                            clicked => {
                                add_sprint(new_sprint_name, new_sprint_start, new_sprint_end);
                                new_sprint_name = "";
                                new_sprint_start = "";
                                new_sprint_end = "";
                            }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            for s in sprints: Rectangle {
                                height: 60px;
                                background: Palette.alternate-background;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: s.number;
                                            vertical-alignment: center;
                                            width: 30px;
                                            font-weight: 700;
                                        }

                                        LineEdit {
                                            text: s.name;
                                            horizontal-stretch: 1;
                                            accepted(val) => {
                                                update_sprint(s.number, val, "", "");
                                            }
                                        }

                                        LineEdit {
                                            text: s.start_date;
                                            width: 110px;
                                            accepted(val) => {
                                                update_sprint(s.number, "", val, "");
                                            }
                                        }

                                        LineEdit {
                                            text: s.end_date;
                                            width: 110px;
                                            accepted(val) => {
                                                update_sprint(s.number, "", "", val);
                                            }
                                        }
                                    }

                                    CloseButton {
                                        size: 24px;
                                        clicked => {
                                            remove_sprint(s.number);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
