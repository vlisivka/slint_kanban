import {
    Button,
    ScrollView,
    VerticalBox,
    HorizontalBox,
    Palette,
} from "std-widgets.slint";
import { TicketStr } from "../common.slint";

export component TicketView inherits Rectangle {
    in property <TicketStr> ticket;
    callback close();
    callback edit();
    callback navigate_to(string);
    callback show_tooltip(string, length, length);
    callback hide_tooltip();

    background: #00000080;

    // Backdrop: clicks outside close the view
    TouchArea {
        clicked => {
            close();
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;

        TouchArea { }

        VerticalBox {
            padding: 40px;
            spacing: 24px;

            HorizontalLayout {
                padding: 0px;
                alignment: space-between;

                edit-btn := Button {
                    text: "Edit";
                    width: 100px;
                    height: 40px;
                    clicked => {
                        edit();
                    }
                }

                VerticalBox {
                    padding: 0px;
                    spacing: 4px;
                    title-txt := Text {
                        text: ticket.title;
                        font-size: 32px;
                        font-weight: 800;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    if ticket.assigned_to != "": Text {
                        text: "Assigned to: " + ticket.assigned_to;
                        font-size: 14px;
                        font-weight: 400;
                        horizontal-alignment: center;
                        opacity: 0.6;
                    }

                    if ticket.author != "": Text {
                        text: "Author: " + ticket.author;
                        font-size: 12px;
                        font-weight: 300;
                        horizontal-alignment: center;
                        color: #d33682;
                        opacity: 0.8;
                    }
                }

                close-btn := Button {
                    text: "Close";
                    width: 100px;
                    height: 40px;
                    clicked => {
                        close();
                    }
                }
            }

            ScrollView {
                VerticalBox {
                    padding: 20px;
                    spacing: 20px;
                    desc-txt := Text {
                        text: ticket.description;
                        font-size: 18px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }

                    if ticket.references.length > 0: VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Related Tickets:";
                            font-size: 16px;
                            font-weight: 800;
                            opacity: 0.7;
                        }

                        HorizontalBox {
                            padding: 0px;
                            alignment: start;
                            for ref in ticket.references: Rectangle {
                                width: ref_label.preferred-width + 20px;
                                height: 32px;
                                border-radius: 4px;
                                background: Palette.alternate-background;

                                ref_label := Text {
                                    text: ref.id;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        navigate_to(ref.id);
                                    }
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            show_tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                        } else {
                                            hide_tooltip();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
