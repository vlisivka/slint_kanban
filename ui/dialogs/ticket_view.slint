import {
    Button,
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Palette,
    TextEdit,
} from "std-widgets.slint";
import {
    TicketStr,
    RefStr,
    IdCopy,
    ModalBackdrop,
    Theme,
    UserGlobal,
} from "../common.slint";

export component TicketView inherits Rectangle {
    in property <TicketStr> ticket;
    callback close();
    callback edit();
    callback navigate-to(string);
    callback show-tooltip(string, length, length);
    callback hide-tooltip();
    callback add-comment(string);
    callback attach-file(string) -> string;
    callback open-attachment-folder(string);
    callback request-stats();

    property <bool> can-manage: !UserGlobal.manage-only-mine || UserGlobal.active-user == ticket.assigned_to || UserGlobal.active-user == ticket.author || UserGlobal.active-user == "admin" || UserGlobal.active-user == "<unassigned>";

    ModalBackdrop {
        dismiss => {
            close();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.background;

            TouchArea { }

            VerticalBox {
                padding: 40px;
                spacing: 24px;

                HorizontalLayout {
                    padding: 0px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        if ticket.id != "board-info": edit-btn := Button {
                            text: @tr("Edit");
                            enabled: root.can-manage;
                            width: 100px;
                            height: 40px;
                            clicked => {
                                edit();
                            }
                        }

                        if ticket.id != "board-info" && ticket.attachment_count > 0: Button {
                            text: @tr("📁 Attachments ({})", ticket.attachment_count);
                            height: 40px;
                            clicked => {
                                open-attachment-folder(ticket.id);
                            }
                        }

                        if ticket.id == "board-info": Button {
                            text: @tr("📊 Statistics");
                            height: 40px;
                            clicked => {
                                request-stats();
                            }
                        }
                    }

                    VerticalBox {
                        padding: 0px;
                        spacing: 4px;
                        title-txt := Text {
                            text: ticket.title;
                            font-size: 32px;
                            font-weight: 800;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        if ticket.id != "" && ticket.id != "board-info": HorizontalLayout {
                            alignment: center;
                            IdCopy {
                                id: ticket.id;
                                font-size: 14px;
                            }
                        }

                        if ticket.assigned_to != "": Text {
                            text: @tr("Assigned to: {}", ticket.assigned_to);
                            font-size: 14px;
                            font-weight: 400;
                            horizontal-alignment: center;
                            opacity: 0.6;
                        }
                        if ticket.points > 0: Text {
                            text: @tr("⭐ {} pts (~{})", ticket.points, (ticket.points == 1 ? @tr("1 day") : ticket.points == 2 ? @tr("2 days") : ticket.points == 3 ? @tr("3 days") : ticket.points == 4 ? @tr("4 days") : ticket.points == 5 ? @tr("1 week") : ticket.points == 6 ? @tr("2 weeks") : ticket.points == 7 ? @tr("1 month") : ticket.points == 8 ? @tr("2-3 months") : ticket.points == 9 ? @tr("6 months") : ticket.points == 10 ? @tr("1 year") : @tr("{} pts", ticket.points)));
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            color: (ticket.points == 1 ? Theme.point-1 : ticket.points == 2 ? Theme.point-2 : ticket.points == 3 ? Theme.point-3 : ticket.points == 4 ? Theme.point-4 : ticket.points == 5 ? Theme.point-5 : ticket.points == 6 ? Theme.point-6 : ticket.points == 7 ? Theme.point-7 : ticket.points == 8 ? Theme.point-8 : ticket.points == 9 ? Theme.point-9 : ticket.points == 10 ? Theme.point-10 : Theme.point-0);
                        }

                        if ticket.author != "": Text {
                            text: @tr("Author: {}", ticket.author);
                            font-size: 12px;
                            font-weight: 300;
                            horizontal-alignment: center;
                            color: Theme.author-color;
                            opacity: 0.8;
                        }

                        if ticket.created_at != "": Text {
                            text: @tr("Created: {}", ticket.created_at);
                            font-size: 11px;
                            horizontal-alignment: center;
                            opacity: 0.5;
                        }

                        if ticket.updated_at != "" && ticket.updated_at != ticket.created_at: Text {
                            text: @tr("Updated: {}", ticket.updated_at);
                            font-size: 11px;
                            horizontal-alignment: center;
                            opacity: 0.5;
                        }
                    }

                    close-btn := Button {
                        text: @tr("Close");
                        width: 100px;
                        height: 40px;
                        clicked => {
                            close();
                        }
                    }
                }

                ScrollView {
                    VerticalBox {
                        padding: 20px;
                        spacing: 20px;
                        desc-txt := Text {
                            text: ticket.description;
                            font-size: 18px;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }

                        if ticket.references.length > 0: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: @tr("Related Tickets:");
                                font-size: 16px;
                                font-weight: 800;
                                opacity: 0.7;
                            }

                            HorizontalBox {
                                padding: 0px;
                                alignment: start;
                                for ref in ticket.references: Rectangle {
                                    width: ref_label.preferred-width + 20px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: Palette.alternate-background;

                                    ref_label := Text {
                                        text: ref.id;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            navigate-to(ref.id);
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                show-tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                            } else {
                                                hide-tooltip();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Comments Section
                        if ticket.comments.length > 0: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: @tr("Comments:");
                                font-size: 16px;
                                font-weight: 800;
                                opacity: 0.7;
                            }

                            for comment in ticket.comments: Rectangle {
                                background: Palette.alternate-background;
                                border-radius: 4px;
                                VerticalBox {
                                    padding: 12px;
                                    spacing: 8px;

                                    Text {
                                        text: @tr("{} at {}", comment.author, comment.created_at);
                                        font-size: 11px;
                                        opacity: 0.6;
                                    }

                                    Text {
                                        text: comment.content;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }

                                    if comment.references.length > 0: HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        alignment: start;
                                        for ref in comment.references: Rectangle {
                                            width: cref_label.preferred-width + 20px;
                                            height: 32px;
                                            border-radius: 4px;
                                            background: Palette.background;

                                            cref_label := Text {
                                                text: ref.id;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    navigate-to(ref.id);
                                                }
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        show-tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                                    } else {
                                                        hide-tooltip();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Add Comment form
                        if ticket.id != "board-info" && ticket.id != "": VerticalBox {
                            visible: root.can-manage;
                            spacing: 8px;
                            padding: 0px;
                            Text {
                                text: @tr("Add a comment:");
                                font-weight: 700;
                            }

                            comment_input := TextEdit {
                                height: 80px;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Button {
                                    text: @tr("Attach File");
                                    height: 40px;
                                    min-width: 120px;
                                    clicked => {
                                        let link = root.attach-file(ticket.id);
                                        if link != "" {
                                            if comment_input.text != "" {
                                                comment_input.text += "\n\n" + link;
                                            } else {
                                                comment_input.text = link;
                                            }
                                        }
                                    }
                                }

                                Button {
                                    text: @tr("Post Comment");
                                    primary: true;
                                    height: 40px;
                                    min-width: 120px;
                                    clicked => {
                                        if comment_input.text != "" {
                                            root.add-comment(comment_input.text);
                                            comment_input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
