import {
    Button,
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Palette,
    TextEdit,
} from "std-widgets.slint";
import {
    TicketStr,
    RefStr,
    IdCopy,
    ModalBackdrop,
    Theme,
} from "../common.slint";

export component TicketView inherits Rectangle {
    in property <TicketStr> ticket;
    callback close();
    callback edit();
    callback navigate-to(string);
    callback show-tooltip(string, length, length);
    callback hide-tooltip();
    callback add-comment(string);
    callback attach-file(string) -> string;
    callback open-attachment-folder(string);
    callback request-stats();

    ModalBackdrop {
        dismiss => {
            close();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.background;

            TouchArea { }

            VerticalBox {
                padding: 40px;
                spacing: 24px;

                HorizontalLayout {
                    padding: 0px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        if ticket.id != "board-info": edit-btn := Button {
                            text: "Edit";
                            width: 100px;
                            height: 40px;
                            clicked => {
                                edit();
                            }
                        }

                        if ticket.id != "board-info" && ticket.attachment_count > 0: Button {
                            text: "📁 Attachments (" + ticket.attachment_count + ")";
                            height: 40px;
                            clicked => {
                                open-attachment-folder(ticket.id);
                            }
                        }

                        if ticket.id == "board-info": Button {
                            text: "📊 Statistics";
                            height: 40px;
                            clicked => {
                                request-stats();
                            }
                        }
                    }

                    VerticalBox {
                        padding: 0px;
                        spacing: 4px;
                        title-txt := Text {
                            text: ticket.title;
                            font-size: 32px;
                            font-weight: 800;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        if ticket.id != "" && ticket.id != "board-info": HorizontalLayout {
                            alignment: center;
                            IdCopy {
                                id: ticket.id;
                                font-size: 14px;
                            }
                        }

                        if ticket.assigned_to != "": Text {
                            text: "Assigned to: " + ticket.assigned_to;
                            font-size: 14px;
                            font-weight: 400;
                            horizontal-alignment: center;
                            opacity: 0.6;
                        }

                        if ticket.author != "": Text {
                            text: "Author: " + ticket.author;
                            font-size: 12px;
                            font-weight: 300;
                            horizontal-alignment: center;
                            color: Theme.author-color;
                            opacity: 0.8;
                        }

                        if ticket.created_at != "": Text {
                            text: "Created: " + ticket.created_at;
                            font-size: 11px;
                            horizontal-alignment: center;
                            opacity: 0.5;
                        }

                        if ticket.updated_at != "" && ticket.updated_at != ticket.created_at: Text {
                            text: "Updated: " + ticket.updated_at;
                            font-size: 11px;
                            horizontal-alignment: center;
                            opacity: 0.5;
                        }
                    }

                    close-btn := Button {
                        text: "Close";
                        width: 100px;
                        height: 40px;
                        clicked => {
                            close();
                        }
                    }
                }

                ScrollView {
                    VerticalBox {
                        padding: 20px;
                        spacing: 20px;
                        desc-txt := Text {
                            text: ticket.description;
                            font-size: 18px;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }

                        if ticket.references.length > 0: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Related Tickets:";
                                font-size: 16px;
                                font-weight: 800;
                                opacity: 0.7;
                            }

                            HorizontalBox {
                                padding: 0px;
                                alignment: start;
                                for ref in ticket.references: Rectangle {
                                    width: ref_label.preferred-width + 20px;
                                    height: 32px;
                                    border-radius: 4px;
                                    background: Palette.alternate-background;

                                    ref_label := Text {
                                        text: ref.id;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            navigate-to(ref.id);
                                        }
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                show-tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                            } else {
                                                hide-tooltip();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Comments Section
                        if ticket.comments.length > 0: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Comments:";
                                font-size: 16px;
                                font-weight: 800;
                                opacity: 0.7;
                            }

                            for comment in ticket.comments: Rectangle {
                                background: Palette.alternate-background;
                                border-radius: 4px;
                                VerticalBox {
                                    padding: 12px;
                                    spacing: 8px;

                                    Text {
                                        text: comment.author + " at " + comment.created_at;
                                        font-size: 11px;
                                        opacity: 0.6;
                                    }

                                    Text {
                                        text: comment.content;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }

                                    if comment.references.length > 0: HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        alignment: start;
                                        for ref in comment.references: Rectangle {
                                            width: cref_label.preferred-width + 20px;
                                            height: 32px;
                                            border-radius: 4px;
                                            background: Palette.background;

                                            cref_label := Text {
                                                text: ref.id;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    navigate-to(ref.id);
                                                }
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        show-tooltip(ref.title, self.absolute-position.x, self.absolute-position.y - 30px);
                                                    } else {
                                                        hide-tooltip();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Add Comment form
                        if ticket.id != "board-info" && ticket.id != "": VerticalBox {
                            spacing: 8px;
                            padding: 0px;
                            Text {
                                text: "Add a comment:";
                                font-weight: 700;
                            }

                            comment_input := TextEdit {
                                height: 80px;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Button {
                                    text: "Attach File";
                                    clicked => {
                                        let link = root.attach-file(ticket.id);
                                        if link != "" {
                                            if comment_input.text != "" {
                                                comment_input.text += "\n\n" + link;
                                            } else {
                                                comment_input.text = link;
                                            }
                                        }
                                    }
                                }

                                Button {
                                    text: "Post Comment";
                                    primary: true;
                                    clicked => {
                                        if comment_input.text != "" {
                                            root.add-comment(comment_input.text);
                                            comment_input.text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
