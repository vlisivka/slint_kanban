import {
    Button,
    LineEdit,
    VerticalBox,
    Palette,
} from "std-widgets.slint";

export component QueueLimitEdit inherits Rectangle {
    in property <string> queue_name;
    in property <string> queue_id;
    in-out property <string> limit_text;

    callback save(string, int); // id, limit
    callback cancel();
    callback remove_limit(string); // id

    background: #00000080;

    // Backdrop: clicks outside cancel the edit
    TouchArea {
        clicked => {
            cancel();
        }
    }

    Rectangle {
        width: 400px;
        height: 280px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.background;
        border-radius: 12px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;

        TouchArea { }

        VerticalBox {
            padding: 24px;
            spacing: 20px;

            Text {
                text: "Set Limit for " + queue_name;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Max Tickets";
                    font-size: 11px;
                    font-weight: 800;
                    opacity: 0.6;
                }

                limit-input := LineEdit {
                    text <=> limit_text;
                    placeholder-text: "e.g. 5, 21";
                    height: 40px;
                    input-type: number;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Button {
                    text: "Cancel";
                    clicked => {
                        cancel();
                    }
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Remove Limit";
                    clicked => {
                        remove_limit(queue_id);
                    }
                    horizontal-stretch: 1;
                }

                save-btn := Button {
                    text: "Save";
                    primary: true;
                    clicked => {
                        save(queue_id, limit_text.to-float());
                    }
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
